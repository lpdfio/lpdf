<?xml version="1.0" encoding="UTF-8"?>
<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema">

  <!-- ============================================================
       Simple Types
  ============================================================ -->

  <xs:simpleType name="TokenScale">
    <xs:restriction base="xs:string">
      <xs:enumeration value="xs"/>
      <xs:enumeration value="s"/>
      <xs:enumeration value="m"/>
      <xs:enumeration value="l"/>
      <xs:enumeration value="xl"/>
      <xs:enumeration value="xxl"/>
    </xs:restriction>
  </xs:simpleType>

  <!-- a name the document gives a token: lowercase letters, digits and -, starting with a letter. An alias
       is used where a slot is: font-size="caption", gap="caption". -->
  <xs:simpleType name="TokenName">
    <xs:restriction base="xs:string">
      <xs:pattern value="[a-z][a-z0-9-]*"/>
    </xs:restriction>
  </xs:simpleType>

  <!-- e.g. "10pt", "25.4mm", or "1in" (non-negative) -->
  <xs:simpleType name="PtValue">
    <xs:restriction base="xs:string">
      <xs:pattern value="\d+(\.\d+)?(pt|mm|in)"/>
    </xs:restriction>
  </xs:simpleType>

  <!-- Same as PtValue but allows a leading minus for coordinates and offsets -->
  <xs:simpleType name="SignedPtValue">
    <xs:restriction base="xs:string">
      <xs:pattern value="-?\d+(\.\d+)?(pt|mm|in)"/>
    </xs:restriction>
  </xs:simpleType>

  <!-- slot, alias of a slot, or explicit pt value, e.g. "m", "caption" or "14pt" -->
  <xs:simpleType name="TokenScaleOrPt">
    <xs:union memberTypes="TokenScale PtValue TokenName"/>
  </xs:simpleType>

  <!-- a factor above 0, e.g. "1.5" -->
  <xs:simpleType name="FactorValue">
    <xs:restriction base="xs:decimal">
      <xs:minExclusive value="0"/>
    </xs:restriction>
  </xs:simpleType>

  <!-- a fraction from 0 (invisible) to 1 (opaque), e.g. "0.5" -->
  <xs:simpleType name="OpacityValue">
    <xs:restriction base="xs:decimal">
      <xs:minInclusive value="0"/>
      <xs:maxInclusive value="1"/>
    </xs:restriction>
  </xs:simpleType>

  <!-- slot, alias of a slot, or a factor, e.g. "m", "body" or "1.5" -->
  <xs:simpleType name="TokenScaleOrFactor">
    <xs:union memberTypes="TokenScale FactorValue TokenName"/>
  </xs:simpleType>

  <!-- e.g. "10pt" | "10pt 12pt" | "10pt 12pt 8pt" | "10pt 12pt 8pt 6pt". A bare 0 needs no unit. -->
  <xs:simpleType name="SpacingValue">
    <xs:restriction base="xs:string">
      <xs:pattern value="(0|\d+(\.\d+)?pt)( (0|\d+(\.\d+)?pt)){0,3}"/>
    </xs:restriction>
  </xs:simpleType>

  <!-- 2 to 4 values, each a length or a slot or alias of the space row, e.g. "s l" | "0pt 0pt 0pt m" | "m 8pt xs" -->
  <xs:simpleType name="SpacingMixed">
    <xs:restriction base="xs:string">
      <xs:pattern value="(0|\d+(\.\d+)?(pt|mm|in)|[a-z][a-z0-9-]*)( (0|\d+(\.\d+)?(pt|mm|in)|[a-z][a-z0-9-]*)){1,3}"/>
    </xs:restriction>
  </xs:simpleType>

  <!-- spacing: a shorthand of lengths, a shorthand that has slots or aliases in it, OR a single slot or alias -->
  <xs:simpleType name="SpacingOrToken">
    <xs:union memberTypes="SpacingValue SpacingMixed TokenScale TokenName"/>
  </xs:simpleType>

  <xs:simpleType name="PageSizeNamed">
    <xs:restriction base="xs:string">
      <xs:enumeration value="a4"/>
      <xs:enumeration value="a3"/>
      <xs:enumeration value="a5"/>
      <xs:enumeration value="letter"/>
      <xs:enumeration value="legal"/>
    </xs:restriction>
  </xs:simpleType>

  <!-- e.g. "100pt 200pt" -->
  <xs:simpleType name="PageSizeCustom">
    <xs:restriction base="xs:string">
      <xs:pattern value="\d+(\.\d+)?pt \d+(\.\d+)?pt"/>
    </xs:restriction>
  </xs:simpleType>

  <xs:simpleType name="PageSize">
    <xs:union memberTypes="PageSizeNamed PageSizeCustom"/>
  </xs:simpleType>

  <xs:simpleType name="Orientation">
    <xs:restriction base="xs:string">
      <xs:enumeration value="portrait"/>
      <xs:enumeration value="landscape"/>
    </xs:restriction>
  </xs:simpleType>

  <xs:simpleType name="SectionType">
    <xs:restriction base="xs:string">
      <xs:enumeration value="toc"/>
    </xs:restriction>
  </xs:simpleType>

  <xs:simpleType name="FootnoteCounter">
    <xs:annotation>
      <xs:documentation>Where the numbers of the footnotes start over: on every page, in every section, or never.</xs:documentation>
    </xs:annotation>
    <xs:restriction base="xs:string">
      <xs:enumeration value="page"/>
      <xs:enumeration value="section"/>
      <xs:enumeration value="document"/>
    </xs:restriction>
  </xs:simpleType>

  <xs:simpleType name="Cipher">
    <xs:annotation>
      <xs:documentation>The cipher a PDF is encrypted with: AES-256, or RC4-128 for readers that cannot open AES-256. PDF 2.0 deprecates RC4-128.</xs:documentation>
    </xs:annotation>
    <xs:restriction base="xs:string">
      <xs:enumeration value="aes-256"/>
      <xs:enumeration value="rc4-128"/>
    </xs:restriction>
  </xs:simpleType>

  <xs:simpleType name="PdfALevel">
    <xs:annotation>
      <xs:documentation>A level of PDF/A, the ISO 19005 standard for files kept for the long term: 2b keeps the look of every page, and 2u adds that all text maps to Unicode, so it can be searched and copied.</xs:documentation>
    </xs:annotation>
    <xs:restriction base="xs:string">
      <xs:enumeration value="2b"/>
      <xs:enumeration value="2u"/>
    </xs:restriction>
  </xs:simpleType>

  <xs:simpleType name="Permission">
    <xs:annotation>
      <xs:documentation>What a reader of an encrypted PDF may do without the owner password: print (at full quality), modify, copy, annotate, fill in forms, extract text for accessibility tools, and assemble (insert, delete and rotate pages).</xs:documentation>
    </xs:annotation>
    <xs:restriction base="xs:string">
      <xs:enumeration value="print"/>
      <xs:enumeration value="modify"/>
      <xs:enumeration value="copy"/>
      <xs:enumeration value="annotate"/>
      <xs:enumeration value="fill-forms"/>
      <xs:enumeration value="accessibility"/>
      <xs:enumeration value="assemble"/>
    </xs:restriction>
  </xs:simpleType>

  <xs:simpleType name="Permissions">
    <xs:list itemType="Permission"/>
  </xs:simpleType>

  <xs:simpleType name="FileRelationship">
    <xs:annotation>
      <xs:documentation>How a file the PDF carries relates to the document: source, the file the document was made from; data, the data its pages show, such as the XML of an e-invoice; alternative, the same content in another form; supplement, more than the pages show; or unspecified.</xs:documentation>
    </xs:annotation>
    <xs:restriction base="xs:string">
      <xs:enumeration value="source"/>
      <xs:enumeration value="data"/>
      <xs:enumeration value="alternative"/>
      <xs:enumeration value="supplement"/>
      <xs:enumeration value="unspecified"/>
    </xs:restriction>
  </xs:simpleType>

  <!-- A media type and a subtype, in the letters PDF/A-3 accepts in an embedded file's Subtype (veraPDF rule 6.8-1) -->
  <xs:simpleType name="MimeType">
    <xs:restriction base="xs:string">
      <xs:pattern value="[A-Za-z0-9_.+\-]+/[A-Za-z0-9_.+\-]+"/>
    </xs:restriction>
  </xs:simpleType>

  <xs:simpleType name="BookmarkLevel">
    <xs:restriction base="xs:positiveInteger">
      <xs:maxInclusive value="6"/>
    </xs:restriction>
  </xs:simpleType>

  <!-- how many heading levels of a markdown become bookmarks: 0 for none -->
  <xs:simpleType name="MarkdownBookmarks">
    <xs:restriction base="xs:nonNegativeInteger">
      <xs:maxInclusive value="6"/>
    </xs:restriction>
  </xs:simpleType>

  <!-- a color as written: hex, or cmyk() with 0-100 values, rgb() with 0-255 values, or hsl() with a 0-360 hue and
       saturation and lightness in %. The values are separated by commas or by spaces, not a mix. The pattern checks
       the form; the engine checks the ranges. e.g. "#1763cf", "#fff", "cmyk(91, 61, 0, 19)", "rgb(23 99 207)",
       "hsl(215, 80%, 45%)". The same alternatives are in Color, Fill and ShadowValue. -->
  <xs:simpleType name="ColorHex">
    <xs:restriction base="xs:string">
      <xs:pattern value="#[0-9a-fA-F]{3}([0-9a-fA-F]{3})?|cmyk\(\s*(\d+(\.\d+)?(\s*,\s*\d+(\.\d+)?){3}|\d+(\.\d+)?(\s+\d+(\.\d+)?){3})\s*\)|rgb\(\s*(\d+(\.\d+)?(\s*,\s*\d+(\.\d+)?){2}|\d+(\.\d+)?(\s+\d+(\.\d+)?){2})\s*\)|hsl\(\s*(\d+(\.\d+)?\s*,\s*\d+(\.\d+)?%\s*,\s*\d+(\.\d+)?%|\d+(\.\d+)?\s+\d+(\.\d+)?%\s+\d+(\.\d+)?%)\s*\)"/>
    </xs:restriction>
  </xs:simpleType>

  <!-- a color as written, or a named color token e.g. "primary", "surface-alt" -->
  <xs:simpleType name="Color">
    <xs:restriction base="xs:string">
      <xs:pattern value="#[0-9a-fA-F]{3}([0-9a-fA-F]{3})?|cmyk\(\s*(\d+(\.\d+)?(\s*,\s*\d+(\.\d+)?){3}|\d+(\.\d+)?(\s+\d+(\.\d+)?){3})\s*\)|rgb\(\s*(\d+(\.\d+)?(\s*,\s*\d+(\.\d+)?){2}|\d+(\.\d+)?(\s+\d+(\.\d+)?){2})\s*\)|hsl\(\s*(\d+(\.\d+)?\s*,\s*\d+(\.\d+)?%\s*,\s*\d+(\.\d+)?%|\d+(\.\d+)?\s+\d+(\.\d+)?%\s+\d+(\.\d+)?%)\s*\)|[a-z][a-z0-9-]*"/>
    </xs:restriction>
  </xs:simpleType>

  <!-- a color, or a gradient of the tokens e.g. "gradient:brand-fade" -->
  <xs:simpleType name="Fill">
    <xs:restriction base="xs:string">
      <xs:pattern value="#[0-9a-fA-F]{3}([0-9a-fA-F]{3})?|cmyk\(\s*(\d+(\.\d+)?(\s*,\s*\d+(\.\d+)?){3}|\d+(\.\d+)?(\s+\d+(\.\d+)?){3})\s*\)|rgb\(\s*(\d+(\.\d+)?(\s*,\s*\d+(\.\d+)?){2}|\d+(\.\d+)?(\s+\d+(\.\d+)?){2})\s*\)|hsl\(\s*(\d+(\.\d+)?\s*,\s*\d+(\.\d+)?%\s*,\s*\d+(\.\d+)?%|\d+(\.\d+)?\s+\d+(\.\d+)?%\s+\d+(\.\d+)?%)\s*\)|gradient:[a-z][a-z0-9-]*|[a-z][a-z0-9-]*"/>
    </xs:restriction>
  </xs:simpleType>

  <!-- where a gradient stop sits, from 0% to 100% e.g. "60%" -->
  <xs:simpleType name="GradientOffset">
    <xs:restriction base="xs:string">
      <xs:pattern value="(100(\.0+)?|[0-9]{1,2}(\.[0-9]+)?)%"/>
    </xs:restriction>
  </xs:simpleType>

  <xs:simpleType name="GradientType">
    <xs:restriction base="xs:string">
      <xs:enumeration value="linear"/>
      <xs:enumeration value="radial"/>
    </xs:restriction>
  </xs:simpleType>

  <!-- x offset, y offset, color and optionally an opacity, e.g. "2pt 3pt #000000" or "2pt 3pt text 0.2" -->
  <xs:simpleType name="ShadowValue">
    <xs:restriction base="xs:string">
      <xs:pattern value="-?\d+(\.\d+)?(pt|mm|in) -?\d+(\.\d+)?(pt|mm|in) (#[0-9a-fA-F]{3}([0-9a-fA-F]{3})?|cmyk\(\s*(\d+(\.\d+)?(\s*,\s*\d+(\.\d+)?){3}|\d+(\.\d+)?(\s+\d+(\.\d+)?){3})\s*\)|rgb\(\s*(\d+(\.\d+)?(\s*,\s*\d+(\.\d+)?){2}|\d+(\.\d+)?(\s+\d+(\.\d+)?){2})\s*\)|hsl\(\s*(\d+(\.\d+)?\s*,\s*\d+(\.\d+)?%\s*,\s*\d+(\.\d+)?%|\d+(\.\d+)?\s+\d+(\.\d+)?%\s+\d+(\.\d+)?%)\s*\)|[a-z][a-z0-9-]*)( (0(\.\d+)?|1(\.0+)?|\.\d+))?"/>
    </xs:restriction>
  </xs:simpleType>

  <!-- e.g. "s #ccc", "m primary", "hairline primary" (an alias of a slot), or "1.5pt #ccc" -->
  <xs:simpleType name="BorderValue">
    <xs:restriction base="xs:string">
      <xs:pattern value="(\d+(\.\d+)?pt|[a-z][a-z0-9-]*) .+"/>
    </xs:restriction>
  </xs:simpleType>

  <!-- a border as above, or none: e.g. "xs line-muted" or "none" -->
  <xs:simpleType name="LineValue">
    <xs:restriction base="xs:string">
      <xs:pattern value="none|(\d+(\.\d+)?pt|[a-z][a-z0-9-]*) .+"/>
    </xs:restriction>
  </xs:simpleType>

  <!-- cross-axis alignment (a column also supports stretch) -->
  <xs:simpleType name="AlignFull">
    <xs:restriction base="xs:string">
      <xs:enumeration value="start"/>
      <xs:enumeration value="center"/>
      <xs:enumeration value="end"/>
      <xs:enumeration value="stretch"/>
    </xs:restriction>
  </xs:simpleType>

  <xs:simpleType name="Align">
    <xs:restriction base="xs:string">
      <xs:enumeration value="start"/>
      <xs:enumeration value="center"/>
      <xs:enumeration value="end"/>
    </xs:restriction>
  </xs:simpleType>

  <xs:simpleType name="Justify">
    <xs:restriction base="xs:string">
      <xs:enumeration value="start"/>
      <xs:enumeration value="center"/>
      <xs:enumeration value="end"/>
      <xs:enumeration value="between"/>
    </xs:restriction>
  </xs:simpleType>

  <xs:simpleType name="CaptureMode">
    <xs:restriction base="xs:string">
      <xs:enumeration value="first"/>
      <xs:enumeration value="last"/>
    </xs:restriction>
  </xs:simpleType>

  <xs:simpleType name="Paginate">
    <xs:restriction base="xs:string">
      <xs:enumeration value="no"/>
      <xs:enumeration value="break-before"/>
      <xs:enumeration value="break-after"/>
      <xs:enumeration value="keep-next"/>
    </xs:restriction>
  </xs:simpleType>

  <xs:simpleType name="RowKeep">
    <xs:restriction base="xs:string">
      <xs:enumeration value="with-next"/>
    </xs:restriction>
  </xs:simpleType>

  <xs:simpleType name="ListType">
    <xs:restriction base="xs:string">
      <xs:enumeration value="bullet"/>
      <xs:enumeration value="number"/>
    </xs:restriction>
  </xs:simpleType>

  <xs:simpleType name="ListFormat">
    <xs:restriction base="xs:string">
      <xs:enumeration value="decimal"/>
      <xs:enumeration value="lower-alpha"/>
      <xs:enumeration value="upper-alpha"/>
      <xs:enumeration value="lower-roman"/>
      <xs:enumeration value="upper-roman"/>
    </xs:restriction>
  </xs:simpleType>

  <xs:simpleType name="ListBullet">
    <xs:restriction base="xs:string">
      <xs:enumeration value="disc"/>
      <xs:enumeration value="circle"/>
      <xs:enumeration value="square"/>
      <xs:enumeration value="dash"/>
    </xs:restriction>
  </xs:simpleType>

  <xs:simpleType name="TextAlignH">
    <xs:restriction base="xs:string">
      <xs:enumeration value="left"/>
      <xs:enumeration value="center"/>
      <xs:enumeration value="right"/>
      <xs:enumeration value="justify"/>
    </xs:restriction>
  </xs:simpleType>

  <!-- "full", "fill", a slot or an alias of one, or an explicit pt value e.g. "48pt" -->
  <xs:simpleType name="HeightValue">
    <xs:union memberTypes="HeightMode TokenScale PtValue TokenName"/>
  </xs:simpleType>

  <xs:simpleType name="HeightMode">
    <xs:restriction base="xs:string">
      <xs:enumeration value="full"/>
      <xs:enumeration value="fill"/>
    </xs:restriction>
  </xs:simpleType>

  <!-- "fill", a slot or an alias of one, or an explicit pt value e.g. "120pt" -->
  <xs:simpleType name="WidthValue">
    <xs:union memberTypes="WidthMode TokenScale PtValue TokenName"/>
  </xs:simpleType>

  <xs:simpleType name="WidthMode">
    <xs:restriction base="xs:string">
      <xs:enumeration value="fill"/>
    </xs:restriction>
  </xs:simpleType>

  <!-- Nine reference points on the page (vertical-first naming) -->
  <xs:simpleType name="Anchor">
    <xs:restriction base="xs:string">
      <xs:enumeration value="top-left"/>
      <xs:enumeration value="top-center"/>
      <xs:enumeration value="top-right"/>
      <xs:enumeration value="center-left"/>
      <xs:enumeration value="center"/>
      <xs:enumeration value="center-right"/>
      <xs:enumeration value="bottom-left"/>
      <xs:enumeration value="bottom-center"/>
      <xs:enumeration value="bottom-right"/>
    </xs:restriction>
  </xs:simpleType>

  <!-- Keyword or numeric page range (section-relative) -->
  <xs:simpleType name="PageScope">
    <xs:union>
      <xs:simpleType>
        <xs:restriction base="xs:string">
          <xs:enumeration value="each"/>
          <xs:enumeration value="first"/>
          <xs:enumeration value="last"/>
          <xs:enumeration value="odd"/>
          <xs:enumeration value="even"/>
        </xs:restriction>
      </xs:simpleType>
      <xs:simpleType>
        <xs:restriction base="xs:string">
          <!-- matches: 1  |  1-3  |  1-last  |  1,3  |  1,3-5,7-last -->
          <xs:pattern value="[1-9]\d*(-([1-9]\d*|last))?(,[1-9]\d*(-([1-9]\d*|last))?)*"/>
        </xs:restriction>
      </xs:simpleType>
    </xs:union>
  </xs:simpleType>

  <xs:simpleType name="LineCap">
    <xs:restriction base="xs:string">
      <xs:enumeration value="butt"/>
      <xs:enumeration value="round"/>
      <xs:enumeration value="square"/>
    </xs:restriction>
  </xs:simpleType>

  <xs:simpleType name="FillRule">
    <xs:restriction base="xs:string">
      <xs:enumeration value="nonzero"/>
      <xs:enumeration value="evenodd"/>
    </xs:restriction>
  </xs:simpleType>

  <!-- Pin positions for layout regions; top/bottom implemented in Phase 2;
       left/right schema-valid but implementation deferred. -->
  <xs:simpleType name="RegionPin">
    <xs:restriction base="xs:string">
      <xs:enumeration value="top"/>
      <xs:enumeration value="bottom"/>
      <xs:enumeration value="left"/>
      <xs:enumeration value="right"/>
    </xs:restriction>
  </xs:simpleType>

  <xs:simpleType name="BuiltinFont">
    <xs:restriction base="xs:string">
      <xs:enumeration value="Courier"/>
      <xs:enumeration value="Courier-Bold"/>
      <xs:enumeration value="Courier-Oblique"/>
      <xs:enumeration value="Courier-BoldOblique"/>
      <xs:enumeration value="Helvetica"/>
      <xs:enumeration value="Helvetica-Bold"/>
      <xs:enumeration value="Helvetica-Oblique"/>
      <xs:enumeration value="Helvetica-BoldOblique"/>
      <xs:enumeration value="Times-Roman"/>
      <xs:enumeration value="Times-Bold"/>
      <xs:enumeration value="Times-Italic"/>
      <xs:enumeration value="Times-BoldItalic"/>
      <xs:enumeration value="Symbol"/>
      <xs:enumeration value="ZapfDingbats"/>
    </xs:restriction>
  </xs:simpleType>


  <!-- ============================================================
       Reusable complex types
  ============================================================ -->

  <!-- All six scale slots with pt values — used by every token row -->
  <xs:complexType name="TokenScaleRow">
    <xs:attribute name="xs"  type="PtValue" use="required"/>
    <xs:attribute name="s"   type="PtValue" use="required"/>
    <xs:attribute name="m"   type="PtValue" use="required"/>
    <xs:attribute name="l"   type="PtValue" use="required"/>
    <xs:attribute name="xl"  type="PtValue" use="required"/>
    <xs:attribute name="xxl" type="PtValue" use="required"/>
  </xs:complexType>

  <!-- All six scale slots with factors — the line-height row -->
  <xs:complexType name="TokenFactorRow">
    <xs:attribute name="xs"  type="FactorValue" use="required"/>
    <xs:attribute name="s"   type="FactorValue" use="required"/>
    <xs:attribute name="m"   type="FactorValue" use="required"/>
    <xs:attribute name="l"   type="FactorValue" use="required"/>
    <xs:attribute name="xl"  type="FactorValue" use="required"/>
    <xs:attribute name="xxl" type="FactorValue" use="required"/>
  </xs:complexType>


  <!-- ============================================================
       Shared attribute groups
  ============================================================ -->

  <!-- Data-binding attrs valid on any layout element.
       data-value  : dot-path to a scalar; replaces the element's text content.
       data-source : dot-path to an array; repeats this element once per item.
       data-if     : dot-path to a value; element is rendered only when truthy.
       data-if-not : dot-path to a value; element is rendered only when falsy. -->
  <xs:attributeGroup name="DataBindingAttrs">
    <xs:attribute name="data-value"  type="xs:string"/>
    <xs:attribute name="data-source" type="xs:string"/>
    <xs:attribute name="data-if"     type="xs:string"/>
    <xs:attribute name="data-if-not" type="xs:string"/>
  </xs:attributeGroup>

  <!-- Data binding for a layer and the elements in it: a value, or whether they are drawn. They read single
       values, so there is no data-source: a list belongs in the layout. -->
  <xs:attributeGroup name="DataConditionAttrs">
    <xs:attribute name="data-if"     type="xs:string"/>
    <xs:attribute name="data-if-not" type="xs:string"/>
  </xs:attributeGroup>
  <xs:attributeGroup name="DataValueAttrs">
    <xs:attribute name="data-value"  type="xs:string"/>
    <xs:attributeGroup ref="DataConditionAttrs"/>
  </xs:attributeGroup>

  <!-- Attributes that read their value from the data, as data-value does for text: the same dot-paths, loop scopes,
       / and ../. The attribute of the same name without data- is what stays when the path finds nothing. -->
  <xs:attributeGroup name="DataHrefAttr">
    <xs:attribute name="data-href" type="xs:string">
      <xs:annotation>
        <xs:documentation>Dot-path to a string that sets href. When the path finds nothing, href stays, so it is the fallback.</xs:documentation>
      </xs:annotation>
    </xs:attribute>
  </xs:attributeGroup>
  <xs:attributeGroup name="DataNameAttr">
    <xs:attribute name="data-name" type="xs:string">
      <xs:annotation>
        <xs:documentation>Dot-path to a string that sets name: one of the images declared in assets, so the data chooses among the images the caller loaded and can't add one. When the path finds nothing, name stays, so it is the fallback. A name that is not declared is an error that names the path.</xs:documentation>
      </xs:annotation>
    </xs:attribute>
  </xs:attributeGroup>
  <xs:attributeGroup name="DataColorAttr">
    <xs:attribute name="data-color" type="xs:string">
      <xs:annotation>
        <xs:documentation>Dot-path to a string that sets color: a color as written (hex, cmyk(), rgb() or hsl()) or a name from the colors row of the tokens. When the path finds nothing, color stays. A value that is not a color is an error that names the path.</xs:documentation>
      </xs:annotation>
    </xs:attribute>
  </xs:attributeGroup>
  <xs:attributeGroup name="DataBackgroundAttr">
    <xs:attribute name="data-background" type="xs:string">
      <xs:annotation>
        <xs:documentation>Dot-path to a string that sets background: a color, or gradient:name where the element takes a gradient. When the path finds nothing, background stays. A value that is not a fill is an error that names the path.</xs:documentation>
      </xs:annotation>
    </xs:attribute>
  </xs:attributeGroup>
  <xs:attributeGroup name="DataFillAttr">
    <xs:attribute name="data-fill" type="xs:string">
      <xs:annotation>
        <xs:documentation>Dot-path to a string that sets fill: a color, or gradient:name. When the path finds nothing, fill stays. A value that is not a fill is an error that names the path.</xs:documentation>
      </xs:annotation>
    </xs:attribute>
  </xs:attributeGroup>

  <!-- Box attrs shared by all layout elements -->
  <xs:attributeGroup name="BoxAttrs">
    <xs:attribute name="font"       type="xs:string"/>
    <xs:attribute name="font-size"  type="TokenScaleOrPt"/>
    <xs:attribute name="color"      type="Color">
      <xs:annotation>
        <xs:documentation>The color of the text inside the box. A text that sets no color of its own takes the nearest box's, and the text token when no box sets one. A divider or a barcode in the box keeps its own color.</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="gap"        type="TokenScaleOrPt"/>
    <xs:attribute name="padding"    type="SpacingOrToken">
      <xs:annotation>
        <xs:documentation>Space between the edge of the box and its content, written like CSS: one value for all sides, two for top-bottom and left-right, three for top, left-right and bottom, four for top, right, bottom and left. Each value is a length or a name from the space row of the tokens, and they can be mixed: 0pt 0pt 0pt m.</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="height"     type="HeightValue">
      <xs:annotation>
        <xs:documentation>Height of the box. Leave it out to size to the content. A length, or a name from the height row of the tokens, fixes it; fill takes what is left after its siblings (shared equally if several use fill); full takes all the height available. Any of these stops the box splitting across pages.</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="background" type="Fill"/>
    <xs:attribute name="border"     type="BorderValue"/>
    <xs:attribute name="radius"     type="TokenScaleOrPt"/>
    <xs:attribute name="opacity"    type="OpacityValue">
      <xs:annotation>
        <xs:documentation>How opaque the box and everything in it is, from 0 to 1. The box is faded as one, so children that overlap do not show through each other, and a box inside a faded box is faded further: 0.5 inside 0.5 is drawn at 0.25. A form field in the box is not faded. Default 1.</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="shadow"     type="ShadowValue">
      <xs:annotation>
        <xs:documentation>A hard-edged shadow: a copy of the box, moved right and down by the first two lengths (negative is left and up) and filled with the color, drawn under the box with the same radius. An opacity from 0 to 1 after the color fades the shadow alone: "2pt 3pt #000000 0.2". There is no blur. The shadow takes no room in the layout, so it can run into the margin or a neighbor, and the siblings after the box are drawn over it. A box with no background shows the shadow only outside it. The box's own opacity fades the box and its shadow together.</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="paginate"   type="Paginate">
      <xs:annotation>
        <xs:documentation>Where the box falls in the page flow. no: never split the box, and move it whole to the next page when it does not fit. break-before: start it on a new page. break-after: start the next sibling on a new page. keep-next: keep it on one page with the sibling that follows, moving both to the next page if that sibling would not fit and cannot start on this page: a table splits after its header and a row, and a text after a few lines, and then it stays with that first part. break-before, break-after and keep-next take effect on the children of layout; on a box inside another box they are not applied. no applies at any depth.</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="debug"      type="xs:boolean"/>
    <xs:attributeGroup ref="DataBindingAttrs"/>
    <xs:attributeGroup ref="DataColorAttr"/>
    <xs:attributeGroup ref="DataBackgroundAttr"/>
  </xs:attributeGroup>

  <!-- width, on every element a row can hold -->
  <xs:attributeGroup name="WidthAttr">
    <xs:attribute name="width" type="WidthValue">
      <xs:annotation>
        <xs:documentation>Width of the element. A length fixes it. fill, in a row, takes the width its line leaves after the other children, shared equally if several on the line use fill, and never moves to the next line; in a column it takes the full width.</xs:documentation>
      </xs:annotation>
    </xs:attribute>
  </xs:attributeGroup>

  <!-- Box attrs for frame — no gap (frame always centers its single child) -->
  <xs:attributeGroup name="FrameBoxAttrs">
    <xs:attribute name="font"       type="xs:string"/>
    <xs:attribute name="font-size"  type="TokenScaleOrPt"/>
    <xs:attribute name="color"      type="Color">
      <xs:annotation>
        <xs:documentation>The color of the text inside the box. A text that sets no color of its own takes the nearest box's, and the text token when no box sets one. A divider or a barcode in the box keeps its own color.</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="padding"    type="SpacingOrToken">
      <xs:annotation>
        <xs:documentation>Space between the edge of the box and its content, written like CSS: one value for all sides, two for top-bottom and left-right, three for top, left-right and bottom, four for top, right, bottom and left. Each value is a length or a name from the space row of the tokens, and they can be mixed: 0pt 0pt 0pt m.</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="height"     type="HeightValue">
      <xs:annotation>
        <xs:documentation>Height of the box. Leave it out to size to the content. A length, or a name from the height row of the tokens, fixes it; fill takes what is left after its siblings (shared equally if several use fill); full takes all the height available. Any of these stops the box splitting across pages.</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="background" type="Fill"/>
    <xs:attribute name="border"     type="BorderValue"/>
    <xs:attribute name="radius"     type="TokenScaleOrPt"/>
    <xs:attribute name="opacity"    type="OpacityValue">
      <xs:annotation>
        <xs:documentation>How opaque the box and everything in it is, from 0 to 1. The box is faded as one, so children that overlap do not show through each other, and a box inside a faded box is faded further: 0.5 inside 0.5 is drawn at 0.25. A form field in the box is not faded. Default 1.</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="shadow"     type="ShadowValue">
      <xs:annotation>
        <xs:documentation>A hard-edged shadow: a copy of the box, moved right and down by the first two lengths (negative is left and up) and filled with the color, drawn under the box with the same radius. An opacity from 0 to 1 after the color fades the shadow alone: "2pt 3pt #000000 0.2". There is no blur. The shadow takes no room in the layout, so it can run into the margin or a neighbor, and the siblings after the box are drawn over it. A box with no background shows the shadow only outside it. The box's own opacity fades the box and its shadow together.</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="paginate"   type="Paginate">
      <xs:annotation>
        <xs:documentation>Where the box falls in the page flow. no: never split the box, and move it whole to the next page when it does not fit. break-before: start it on a new page. break-after: start the next sibling on a new page. keep-next: keep it on one page with the sibling that follows, moving both to the next page if that sibling would not fit and cannot start on this page: a table splits after its header and a row, and a text after a few lines, and then it stays with that first part. break-before, break-after and keep-next take effect on the children of layout; on a box inside another box they are not applied. no applies at any depth.</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="debug"      type="xs:boolean"/>
    <xs:attributeGroup ref="DataBindingAttrs"/>
    <xs:attributeGroup ref="DataColorAttr"/>
    <xs:attributeGroup ref="DataBackgroundAttr"/>
  </xs:attributeGroup>

  <!-- ============================================================
       Layers — what a layer draws. Every element has one set of attributes, wherever it is.
       Shapes exist in layers only. text-at, img-at and barcode-at are the text, image and barcode of
       the layout (TextCore, ImgCore, BarcodeCore) put at a fixed place instead of in the flow.
  ============================================================ -->

  <!-- Shared fill/stroke attributes for the shapes -->
  <xs:attributeGroup name="CanvasFillStrokeAttrs">
    <xs:attribute name="fill"         type="Fill"/>
    <xs:attribute name="stroke"       type="Color"/>
    <xs:attribute name="stroke-width" type="PtValue"/>
    <xs:attribute name="stroke-dash"  type="xs:string"/>
  </xs:attributeGroup>

  <!-- A shadow on a layer shape: the same attribute as on a box -->
  <xs:attributeGroup name="CanvasShadowAttrs">
    <xs:attribute name="shadow" type="ShadowValue">
      <xs:annotation>
        <xs:documentation>A hard-edged shadow: a copy of the shape, moved right and down by the first two lengths (negative is left and up) and filled with the color, drawn under the shape. An opacity from 0 to 1 after the color fades the shadow alone: "2pt 3pt #000000 0.2". There is no blur. A shape with no fill shows the shadow only outside it.</xs:documentation>
      </xs:annotation>
    </xs:attribute>
  </xs:attributeGroup>

  <!-- Positioning rule (enforced by parser, not XSD 1.0):
       anchor OR (x AND y) must be present.
       x and y place the element's box: its top-left corner, or, when anchor is present,
       signed offsets from that point of the page, where the box's matching point goes. -->
  <xs:group name="CanvasPrimitives">
    <xs:choice>
      <xs:element ref="rect"/>
      <xs:element ref="circle"/>
      <xs:element ref="ellipse"/>
      <xs:element ref="line"/>
      <xs:element ref="path"/>
      <xs:element ref="text-at"/>
      <xs:element ref="img-at"/>
      <xs:element ref="barcode-at"/>
    </xs:choice>
  </xs:group>

  <!-- Where the box of a text-at, img-at or barcode-at goes -->
  <xs:attributeGroup name="AtPositionAttrs">
    <xs:attribute name="x"      type="SignedPtValue"/>
    <xs:attribute name="y"      type="SignedPtValue"/>
    <xs:attribute name="anchor" type="Anchor"/>
  </xs:attributeGroup>

  <!-- What a text means in the layout and in a layer -->
  <xs:attributeGroup name="TextCore">
    <xs:attribute name="font-size" type="TokenScaleOrPt"/>
    <xs:attribute name="font"      type="xs:string"/>
    <xs:attribute name="bold" type="xs:boolean">
      <xs:annotation>
        <xs:documentation>Use the bold face of the font. It applies to the 14 built-in fonts: Helvetica becomes Helvetica-Bold, Times-Roman becomes Times-Bold, Courier becomes Courier-Bold, and the oblique and italic faces their bold forms. A custom font has no bold face to pick, so name one in font.</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="color"     type="Color"/>
    <xs:attributeGroup ref="DataColorAttr"/>
    <xs:attribute name="align"     type="TextAlignH"/>
    <xs:attribute name="line-height" type="TokenScaleOrFactor">
      <xs:annotation>
        <xs:documentation>The distance between lines, as a factor of the font size: a number above 0, such as 1.5, or a name from the line-height row of the tokens. Default 1.2, which is the token m.</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="max-lines">
      <xs:annotation>
        <xs:documentation>The most lines drawn. Only whole lines are drawn, and the rest of the text is dropped. A text in the layout has no cap by default and wraps at the width it has; the lines it drops take no room, and a text that splits across pages keeps the cap across them. A text-at is one line by default, and above 1 needs a width to wrap within.</xs:documentation>
      </xs:annotation>
      <xs:simpleType>
        <xs:restriction base="xs:positiveInteger">
          <xs:minInclusive value="1"/>
        </xs:restriction>
      </xs:simpleType>
    </xs:attribute>
    <xs:attribute name="ellipsis" type="xs:boolean">
      <xs:annotation>
        <xs:documentation>End the last line drawn in an ellipsis when max-lines drops text, shortened to fit the width. Off by default: the text stops at the end of a line. A text-at also ends a line in one when it is cut off at its width. A text in the layout without max-lines is never cut, so there it has no effect.</xs:documentation>
      </xs:annotation>
    </xs:attribute>
  </xs:attributeGroup>

  <!-- What an image means in the layout and in a layer -->
  <xs:attributeGroup name="ImgCore">
    <xs:attribute name="name" type="xs:string" use="required"/>
    <xs:attributeGroup ref="DataNameAttr"/>
  </xs:attributeGroup>

  <!-- What a barcode means in the layout and in a layer. Its height comes after these two, and BarcodeStyle after
       the height: the layout's height takes a slot of the tokens and a layer's is a length. -->
  <xs:attributeGroup name="BarcodeCore">
    <xs:attribute name="type" use="required">
      <xs:simpleType>
        <xs:restriction base="xs:string">
          <xs:enumeration value="qr"/>
          <xs:enumeration value="code128"/>
          <xs:enumeration value="ean13"/>
        </xs:restriction>
      </xs:simpleType>
    </xs:attribute>
    <xs:attribute name="data" type="xs:string" use="required"/>
  </xs:attributeGroup>

  <!-- How a barcode looks, in the layout and in a layer -->
  <xs:attributeGroup name="BarcodeStyle">
    <xs:attribute name="ec">
      <xs:simpleType>
        <xs:restriction base="xs:string">
          <xs:enumeration value="L"/>
          <xs:enumeration value="M"/>
          <xs:enumeration value="Q"/>
          <xs:enumeration value="H"/>
        </xs:restriction>
      </xs:simpleType>
    </xs:attribute>
    <xs:attribute name="hrt"        type="xs:boolean"/>
    <xs:attribute name="color"      type="Color"/>
    <xs:attribute name="background" type="Color"/>
    <xs:attributeGroup ref="DataColorAttr"/>
    <xs:attributeGroup ref="DataBackgroundAttr"/>
  </xs:attributeGroup>

  <xs:element name="rect">
    <xs:complexType>
      <xs:attribute name="x"      type="SignedPtValue"/>
      <xs:attribute name="y"      type="SignedPtValue"/>
      <xs:attribute name="width"  type="PtValue" use="required"/>
      <xs:attribute name="height" type="PtValue" use="required"/>
      <xs:attribute name="anchor" type="Anchor"/>
      <xs:attribute name="radius" type="PtValue"/>
      <xs:attributeGroup ref="CanvasFillStrokeAttrs"/>
      <xs:attributeGroup ref="CanvasShadowAttrs"/>
    </xs:complexType>
  </xs:element>

  <xs:element name="circle">
    <xs:complexType>
      <xs:attribute name="x"      type="SignedPtValue">
        <xs:annotation>
          <xs:documentation>Where the circle's box goes, the square of side 2r around it: its left edge, or with anchor, an offset from that point of the page, where the box's matching point goes. The centre is r further in.</xs:documentation>
        </xs:annotation>
      </xs:attribute>
      <xs:attribute name="y"      type="SignedPtValue">
        <xs:annotation>
          <xs:documentation>Where the circle's box goes, the square of side 2r around it: its top edge, or with anchor, an offset from that point of the page, where the box's matching point goes. The centre is r further in.</xs:documentation>
        </xs:annotation>
      </xs:attribute>
      <xs:attribute name="r"      type="PtValue" use="required"/>
      <xs:attribute name="anchor" type="Anchor"/>
      <xs:attributeGroup ref="CanvasFillStrokeAttrs"/>
      <xs:attributeGroup ref="CanvasShadowAttrs"/>
    </xs:complexType>
  </xs:element>

  <xs:element name="ellipse">
    <xs:complexType>
      <xs:attribute name="x"      type="SignedPtValue">
        <xs:annotation>
          <xs:documentation>Where the ellipse's box goes, 2rx wide and 2ry high around it: its left edge, or with anchor, an offset from that point of the page, where the box's matching point goes. The centre is rx further in.</xs:documentation>
        </xs:annotation>
      </xs:attribute>
      <xs:attribute name="y"      type="SignedPtValue">
        <xs:annotation>
          <xs:documentation>Where the ellipse's box goes, 2rx wide and 2ry high around it: its top edge, or with anchor, an offset from that point of the page, where the box's matching point goes. The centre is ry further in.</xs:documentation>
        </xs:annotation>
      </xs:attribute>
      <xs:attribute name="rx"     type="PtValue" use="required"/>
      <xs:attribute name="ry"     type="PtValue" use="required"/>
      <xs:attribute name="anchor" type="Anchor"/>
      <xs:attributeGroup ref="CanvasFillStrokeAttrs"/>
      <xs:attributeGroup ref="CanvasShadowAttrs"/>
    </xs:complexType>
  </xs:element>

  <xs:element name="line">
    <xs:complexType>
      <xs:attribute name="x1"          type="SignedPtValue" use="required"/>
      <xs:attribute name="y1"          type="SignedPtValue" use="required"/>
      <xs:attribute name="x2"          type="SignedPtValue" use="required"/>
      <xs:attribute name="y2"          type="SignedPtValue" use="required"/>
      <xs:attribute name="stroke"       type="Color"/>
      <xs:attribute name="stroke-width" type="PtValue"/>
      <xs:attribute name="stroke-dash"  type="xs:string"/>
      <xs:attribute name="line-cap"     type="LineCap"/>
    </xs:complexType>
  </xs:element>

  <xs:element name="path">
    <xs:complexType>
      <xs:attribute name="d"            type="xs:string" use="required"/>
      <xs:attribute name="fill"         type="Fill"/>
      <xs:attribute name="stroke"       type="Color"/>
      <xs:attribute name="fill-rule"    type="FillRule"/>
      <xs:attribute name="stroke-width" type="PtValue"/>
      <xs:attribute name="stroke-dash"  type="xs:string"/>
      <xs:attribute name="line-cap"     type="LineCap"/>
    </xs:complexType>
  </xs:element>

  <xs:element name="text-at">
    <xs:annotation>
      <xs:documentation>Text at a fixed place on the page. It is the text of the layout, with the same defaults: the document's font or Helvetica, 11pt and the text colour. It is one line unless told otherwise; give width to cut it off at a width or to wrap it with max-lines. x and y place its box: the top-left corner, or with anchor, an offset from that point of the page, where the box's matching point goes. {page} and {pages} in it count within the section, and a text that comes from data belongs in the layout, since a longer text loses its end here without a warning.</xs:documentation>
    </xs:annotation>
    <xs:complexType mixed="true">
      <xs:choice minOccurs="0" maxOccurs="unbounded">
        <xs:element ref="span"/>
        <xs:element ref="code-span"/>
      </xs:choice>
      <xs:attributeGroup ref="AtPositionAttrs"/>
      <xs:attributeGroup ref="TextCore"/>
      <xs:attribute name="width" type="PtValue">
        <xs:annotation>
          <xs:documentation>Width of the box. Without it the text is one line of the width its characters need, and align has no effect; a long text runs on past the edge of the page, which cuts it off, but stays in the PDF. With it, a line past the width is cut off at it, or ends in an ellipsis with ellipsis, and max-lines above 1 wraps the text within it.</xs:documentation>
        </xs:annotation>
      </xs:attribute>
      <xs:attributeGroup ref="DataValueAttrs"/>
    </xs:complexType>
  </xs:element>

  <xs:element name="img-at">
    <xs:annotation>
      <xs:documentation>An image at a fixed place on the page. It needs width or height, and the other follows the image's proportions. With both, they are a maximum: the image takes the largest size that fits in them, and its box becomes that size, so an anchor places the image itself. x and y place its box: the top-left corner, or with anchor, an offset from that point of the page, where the box's matching point goes.</xs:documentation>
    </xs:annotation>
    <xs:complexType>
      <xs:attributeGroup ref="ImgCore"/>
      <xs:attributeGroup ref="AtPositionAttrs"/>
      <xs:attribute name="width"  type="PtValue"/>
      <xs:attribute name="height" type="PtValue"/>
      <xs:attributeGroup ref="DataConditionAttrs"/>
    </xs:complexType>
  </xs:element>

  <xs:element name="barcode-at">
    <xs:annotation>
      <xs:documentation>A barcode at a fixed place on the page. It needs width or height, and the other follows the barcode's proportions. With both, they are a maximum: the barcode takes the largest size that fits in them, and its box becomes that size, so an anchor places the barcode itself. x and y place its box: the top-left corner, or with anchor, an offset from that point of the page, where the box's matching point goes.</xs:documentation>
    </xs:annotation>
    <xs:complexType>
      <xs:attributeGroup ref="BarcodeCore"/>
      <xs:attribute name="height" type="PtValue">
        <xs:annotation>
          <xs:documentation>Height of the whole barcode, with the digits of hrt inside it: they take the bottom 12pt and the bars the rest. A barcode is never stretched. With only a height, the width follows the barcode's proportions. With both width and height, they are a maximum: the barcode takes the largest size that fits in them, and its box becomes that size. A QR code is square, so it takes the smaller of the two. Without a size, a code128 is as wide as its bars at 1pt per module and its bars are 40pt high, and an ean13 is the standard symbol, 0.33mm per module and bars 22.85mm high. The digits of hrt add 12pt to either.</xs:documentation>
        </xs:annotation>
      </xs:attribute>
      <xs:attributeGroup ref="BarcodeStyle"/>
      <xs:attributeGroup ref="AtPositionAttrs"/>
      <xs:attribute name="width" type="PtValue"/>
      <xs:attributeGroup ref="DataValueAttrs"/>
    </xs:complexType>
  </xs:element>

  <!-- layer: absolute-coordinate content, a direct child of <section>.
       Coordinates are top-left origin, y-down, relative to the full page.
       Graphics state scope (page, opacity, transform, clip). Cannot nest. -->
  <xs:element name="layer">
    <xs:annotation>
      <xs:documentation>Draws shapes, text, images and barcodes at exact positions on the page, independent of the flowing layout: watermarks, stamps, page furniture. Coordinates start at the top left corner of the whole page, not inside the layout's margin, and y grows downward. A layer before the section's layout paints under it, and one after paints over it. It sets what applies to all of its content: which pages it appears on, opacity, transform and clip, and the font, size and color of its text. Layers cannot be nested.</xs:documentation>
    </xs:annotation>
    <xs:complexType>
      <xs:sequence>
        <xs:group ref="CanvasPrimitives" minOccurs="0" maxOccurs="unbounded"/>
      </xs:sequence>
      <xs:attribute name="page"      type="PageScope"/>
      <xs:attribute name="opacity"   type="OpacityValue">
        <xs:annotation>
          <xs:documentation>How opaque everything in the layer is, from 0 to 1. To fade one element, put it in a layer of its own.</xs:documentation>
        </xs:annotation>
      </xs:attribute>
      <xs:attribute name="transform" type="xs:string"/>
      <xs:attribute name="clip" type="xs:string">
        <xs:annotation>
          <xs:documentation>A rectangle that cuts off what the layer draws outside it: x y w h, in points from the top left corner of the page.</xs:documentation>
        </xs:annotation>
      </xs:attribute>
      <xs:attribute name="font" type="xs:string">
        <xs:annotation>
          <xs:documentation>The font of the text-at in the layer that sets none of its own. Defaults to the font of the document.</xs:documentation>
        </xs:annotation>
      </xs:attribute>
      <xs:attribute name="font-size" type="TokenScaleOrPt">
        <xs:annotation>
          <xs:documentation>The size of the text-at in the layer that sets none of its own. Defaults to 11pt.</xs:documentation>
        </xs:annotation>
      </xs:attribute>
      <xs:attribute name="color" type="Color">
        <xs:annotation>
          <xs:documentation>The color of the text-at in the layer that sets none of its own. Defaults to the text token.</xs:documentation>
        </xs:annotation>
      </xs:attribute>
      <xs:attributeGroup ref="DataConditionAttrs"/>
    </xs:complexType>
  </xs:element>


  <!-- ============================================================
       Layout content group — any layout element can nest any other
  ============================================================ -->

  <xs:group name="LayoutContent">
    <xs:choice>
      <xs:element ref="column"/>
      <xs:element ref="row"/>
      <xs:element ref="grid"/>
      <xs:element ref="list"/>
      <xs:element ref="frame"/>
      <xs:element ref="link"/>
      <xs:element ref="text"/>
      <xs:element ref="code"/>
      <xs:element ref="img"/>
      <xs:element ref="divider"/>
      <xs:element ref="table"/>
      <xs:element ref="barcode"/>
      <xs:element ref="shape"/>
      <xs:element ref="field"/>
      <xs:element ref="bookmark"/>
    </xs:choice>
  </xs:group>


  <!-- ============================================================
       Token elements
  ============================================================ -->

  <!-- Font asset: either a built-in PDF core font (core=) or a registry key (ref=) -->
  <xs:element name="font">
    <xs:annotation>
        <xs:documentation>Declares a font that text can be set in by name, with the font attribute. A built-in PDF font is named by core; any other font is a file the SDK reads from src, or one loaded on the engine under ref or, with no ref, under the font's own name.</xs:documentation>
    </xs:annotation>
    <xs:complexType>
    <xs:attribute name="name" type="xs:string" use="required">
      <xs:annotation>
        <xs:documentation>The name that the font attribute of a text uses to pick this font: lowercase letters, digits and -, starting with a letter.</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="core" type="BuiltinFont">
      <xs:annotation>
        <xs:documentation>A built-in PDF font, which needs no file.</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="ref" type="xs:string">
      <xs:annotation>
        <xs:documentation>The key the font was loaded under on the engine, when that is not its name.</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="src" type="xs:anyURI">
      <xs:annotation>
        <xs:documentation>A path the SDK reads the font file from, when the font was not loaded on the engine.</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    </xs:complexType>
  </xs:element>

  <!-- Image asset declared in <assets> -->
  <xs:element name="image">
    <xs:annotation>
        <xs:documentation>Declares an image that an img refers to by name. The SDK reads the file from src, or the image was loaded on the engine under ref or, with no ref, under its own name.</xs:documentation>
    </xs:annotation>
    <xs:complexType>
    <xs:attribute name="name" type="xs:string" use="required">
      <xs:annotation>
        <xs:documentation>The name that the name attribute of an img uses to pick this image: lowercase letters, digits and -, starting with a letter.</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="ref" type="xs:string">
      <xs:annotation>
        <xs:documentation>The key the image was loaded under on the engine, when that is not its name.</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="src" type="xs:anyURI">
      <xs:annotation>
        <xs:documentation>A path the SDK reads the image file from, when the image was not loaded on the engine.</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    </xs:complexType>
  </xs:element>

  <xs:element name="color">
    <xs:complexType>
      <xs:attribute name="name"  type="xs:string" use="required"/>
      <xs:attribute name="value" type="ColorHex"  use="required"/>
    </xs:complexType>
  </xs:element>

  <xs:element name="alias">
    <xs:annotation>
      <xs:documentation>A name for a slot of the scale. An attribute that takes a slot (xs to xxl) takes the name instead, and gets that slot of its own row: with caption for xs, font-size="caption" is the text size xs, and gap="caption" the space xs. A name that is neither a slot nor an alias is an error.</xs:documentation>
    </xs:annotation>
    <xs:complexType>
      <xs:attribute name="name" type="TokenName" use="required">
        <xs:annotation>
          <xs:documentation>Lowercase letters, digits and -, starting with a letter. Not xs, s, m, l, xl, xxl, fill or full, which mean something already.</xs:documentation>
        </xs:annotation>
      </xs:attribute>
      <xs:attribute name="value" type="TokenScale" use="required">
        <xs:annotation>
          <xs:documentation>The slot the name stands for: xs, s, m, l, xl or xxl. Not another alias.</xs:documentation>
        </xs:annotation>
      </xs:attribute>
    </xs:complexType>
  </xs:element>

  <xs:element name="stop">
    <xs:complexType>
      <xs:attribute name="offset" type="GradientOffset" use="required">
        <xs:annotation>
          <xs:documentation>Where the color is reached along the gradient, from 0% (the start) to 100% (the end). Stops go in increasing order.</xs:documentation>
        </xs:annotation>
      </xs:attribute>
      <xs:attribute name="color" type="Color" use="required">
        <xs:annotation>
          <xs:documentation>The color at the stop: hex, cmyk(), rgb(), hsl() or a color token. The stops of a gradient are all CMYK or all RGB.</xs:documentation>
        </xs:annotation>
      </xs:attribute>
    </xs:complexType>
  </xs:element>

  <xs:element name="gradient">
    <xs:annotation>
      <xs:documentation>A named blend of colors. A background or a fill uses it as gradient:name, and the blend spans the box it fills. Give from and to for two colors, or stop children for more.</xs:documentation>
    </xs:annotation>
    <xs:complexType>
      <xs:sequence>
        <xs:element ref="stop" minOccurs="0" maxOccurs="unbounded"/>
      </xs:sequence>
      <xs:attribute name="name" type="xs:string" use="required">
        <xs:annotation>
          <xs:documentation>The name a background or a fill gives after gradient:. Lowercase letters, digits and hyphens, starting with a letter.</xs:documentation>
        </xs:annotation>
      </xs:attribute>
      <xs:attribute name="type" type="GradientType" use="required">
        <xs:annotation>
          <xs:documentation>linear runs along a line across the box. radial runs from the center out to the farthest corner.</xs:documentation>
        </xs:annotation>
      </xs:attribute>
      <xs:attribute name="from" type="Color">
        <xs:annotation>
          <xs:documentation>The first color: hex, cmyk(), rgb(), hsl() or a color token, CMYK if to is and RGB if it is not. Used with to, when there are no stop children. For a radial gradient it is the center.</xs:documentation>
        </xs:annotation>
      </xs:attribute>
      <xs:attribute name="to" type="Color">
        <xs:annotation>
          <xs:documentation>The last color: hex, cmyk(), rgb(), hsl() or a color token. Used with from, when there are no stop children. For a radial gradient it is the edge.</xs:documentation>
        </xs:annotation>
      </xs:attribute>
      <xs:attribute name="angle" type="xs:decimal">
        <xs:annotation>
          <xs:documentation>The direction of a linear gradient, in degrees: 0 runs from the top to the bottom, 90 from the left to the right, 180 from the bottom to the top. Default 0. A radial gradient has no direction.</xs:documentation>
        </xs:annotation>
      </xs:attribute>
    </xs:complexType>
  </xs:element>

  <xs:element name="tokens">
    <xs:complexType>
      <xs:all>
        <xs:element name="space"  type="TokenScaleRow" minOccurs="0"/>
        <xs:element name="border" type="TokenScaleRow" minOccurs="0"/>
        <xs:element name="radius" type="TokenScaleRow" minOccurs="0"/>
        <xs:element name="width"  type="TokenScaleRow" minOccurs="0"/>
        <xs:element name="height" type="TokenScaleRow" minOccurs="0"/>
        <xs:element name="text-size" type="TokenScaleRow" minOccurs="0"/>
        <xs:element name="line-height" type="TokenFactorRow" minOccurs="0"/>
        <!-- "grid" and "space" share the same shape -->
        <xs:element name="grid"   type="TokenScaleRow" minOccurs="0"/>
        <xs:element name="aliases" minOccurs="0">
          <xs:complexType>
            <xs:sequence>
              <xs:element ref="alias" minOccurs="0" maxOccurs="unbounded"/>
            </xs:sequence>
          </xs:complexType>
        </xs:element>
        <xs:element name="colors" minOccurs="0">
          <xs:complexType>
            <xs:sequence>
              <xs:element ref="color" minOccurs="0" maxOccurs="unbounded"/>
            </xs:sequence>
          </xs:complexType>
        </xs:element>
        <xs:element name="gradients" minOccurs="0">
          <xs:complexType>
            <xs:sequence>
              <xs:element ref="gradient" minOccurs="0" maxOccurs="unbounded"/>
            </xs:sequence>
          </xs:complexType>
        </xs:element>
      </xs:all>
    </xs:complexType>
  </xs:element>

  <!-- Asset declarations: fonts and images used by layout elements -->
  <xs:element name="assets">
    <xs:complexType>
      <xs:choice minOccurs="0" maxOccurs="unbounded">
        <xs:element ref="font"/>
        <xs:element ref="image"/>
      </xs:choice>
    </xs:complexType>
  </xs:element>


  <!-- ============================================================
       Document structure
  ============================================================ -->

  <xs:element name="meta">
    <xs:complexType>
      <xs:attribute name="title"    type="xs:string"/>
      <xs:attribute name="author"   type="xs:string"/>
      <xs:attribute name="subject"  type="xs:string"/>
      <xs:attribute name="keywords" type="xs:string"/>
      <xs:attribute name="creator"  type="xs:string"/>
    </xs:complexType>
  </xs:element>

  <xs:element name="output">
    <xs:annotation>
      <xs:documentation>How the PDF file is written, apart from what its pages show: whether it is encrypted, and what a reader may do with it, and the standard it meets. The passwords are not here: they come with the render call, since they change from one render to the next. A document that asks for encryption renders only with an owner password, or when the render asks to skip the encryption, as a preview does.</xs:documentation>
    </xs:annotation>
    <xs:complexType>
      <xs:attribute name="encrypt" type="Cipher">
        <xs:annotation>
          <xs:documentation>Encrypts the PDF with this cipher, with the passwords given to the render call: aes-256, or rc4-128 for readers that cannot open AES-256. Without it the PDF is not encrypted, and passwords given to the render call are an error.</xs:documentation>
        </xs:annotation>
      </xs:attribute>
      <xs:attribute name="allow" type="Permissions">
        <xs:annotation>
          <xs:documentation>What a reader may do without the owner password, separated by spaces: print, modify, copy, annotate, fill-forms, accessibility and assemble. Without allow everything is allowed; allow="" allows nothing. It needs encrypt. Readers that follow the standard honor it, and a tool that does not can remove it, so use an open password when the content must stay private.</xs:documentation>
        </xs:annotation>
      </xs:attribute>
      <xs:attribute name="pdfa" type="PdfALevel">
        <xs:annotation>
          <xs:documentation>Writes the PDF as PDF/A, for archives, courts, public bodies and banks: 2b, or 2u when its text must also be searchable. The file carries its fonts, the sRGB color profile and its metadata, and the render needs created_on, the date the file carries. What PDF/A cannot hold is an error that says what to change: text in a built-in font such as the default Helvetica (declare a font in assets), a font whose license forbids embedding, a character the font has no glyph for, a CMYK color, a form field, the digits of a barcode, encrypt, and attachments.</xs:documentation>
        </xs:annotation>
      </xs:attribute>
    </xs:complexType>
  </xs:element>

  <xs:element name="attachments">
    <xs:annotation>
      <xs:documentation>Files the PDF carries inside it, such as the data of an invoice, the source of a report or its terms: a reader lists them in its attachments panel and saves them from there. The engine does not draw them; it carries each as it is. In an encrypted PDF they are encrypted with the rest, under the same passwords. A PDF/A-2 file can carry only files that are PDF/A themselves, so attachments and pdfa are an error.</xs:documentation>
    </xs:annotation>
    <xs:complexType>
      <xs:sequence>
        <xs:element ref="file" minOccurs="0" maxOccurs="unbounded"/>
      </xs:sequence>
    </xs:complexType>
  </xs:element>

  <xs:element name="file">
    <xs:annotation>
      <xs:documentation>A file the PDF carries, under the name a reader shows. The SDK reads it from src, or it was loaded on the engine under ref or, with no ref, under its own name. A file with no bytes is an error, and so are two files with the same name.</xs:documentation>
    </xs:annotation>
    <xs:complexType>
      <xs:attribute name="name" type="xs:string" use="required">
        <xs:annotation>
          <xs:documentation>The name a reader shows the file under and saves it as, such as invoice.xml. Each file of the document has a name of its own.</xs:documentation>
        </xs:annotation>
      </xs:attribute>
      <xs:attribute name="src" type="xs:anyURI">
        <xs:annotation>
          <xs:documentation>A path the SDK reads the file from, when the file was not loaded on the engine.</xs:documentation>
        </xs:annotation>
      </xs:attribute>
      <xs:attribute name="ref" type="xs:string">
        <xs:annotation>
          <xs:documentation>The key the file was loaded under on the engine, when that is not its name.</xs:documentation>
        </xs:annotation>
      </xs:attribute>
      <xs:attribute name="mime" type="MimeType">
        <xs:annotation>
          <xs:documentation>The type of the file, such as text/xml, application/pdf or text/csv. Defaults to application/octet-stream, which says only that it is a file.</xs:documentation>
        </xs:annotation>
      </xs:attribute>
      <xs:attribute name="relationship" type="FileRelationship">
        <xs:annotation>
          <xs:documentation>How the file relates to the document: source, data, alternative, supplement or unspecified, the default. An e-invoice's XML is data.</xs:documentation>
        </xs:annotation>
      </xs:attribute>
      <xs:attribute name="description" type="xs:string">
        <xs:annotation>
          <xs:documentation>A line about the file, which a reader shows beside its name.</xs:documentation>
        </xs:annotation>
      </xs:attribute>
    </xs:complexType>
  </xs:element>

  <xs:element name="layout">
    <xs:annotation>
      <xs:documentation>The flowing content of a section. Elements stack down the page, and a new page starts when one runs out of room. Put headers and footers in a region, which sits outside the flow.</xs:documentation>
    </xs:annotation>
    <xs:complexType>
      <xs:choice minOccurs="0" maxOccurs="unbounded">
        <xs:group ref="LayoutContent"/>
        <!-- Pinned region: reserves a slot at the specified edge of the content area.
             pin="top|bottom" implemented in this phase.
             pin="left|right" schema-valid but deferred (requires w attribute).
             Only valid as a direct child of <layout>, not inside containers. Several regions on one
             edge stack in the order they are written. -->
        <xs:element name="region">
          <xs:annotation>
            <xs:documentation>Pins content to the top or bottom edge of pages, outside the normal flow, for headers and footers. It reserves that space on every page it appears on. Only allowed directly inside layout. Where it is written among the flow does not matter: pin chooses the edge, and regions on one edge stack in the order written.</xs:documentation>
          </xs:annotation>
          <xs:complexType>
            <xs:sequence>
              <xs:group ref="LayoutContent" minOccurs="0" maxOccurs="unbounded"/>
            </xs:sequence>
            <xs:attribute name="pin"   type="RegionPin" use="required">
              <xs:annotation>
                <xs:documentation>Which edge the region sticks to. top and bottom work. left and right pass validation but are not implemented yet.</xs:documentation>
              </xs:annotation>
            </xs:attribute>
            <xs:attribute name="page"  type="PageScope">
              <xs:annotation>
                <xs:documentation>Which pages show the region: each, first, last, odd, even, or a range such as 2-last. Defaults to each.</xs:documentation>
              </xs:annotation>
            </xs:attribute>
            <!-- w is for pin="left|right", which are not implemented; it is read and not used -->
            <xs:attribute name="w"     type="PtValue"/>
            <xs:attribute name="debug" type="xs:boolean"/>
          </xs:complexType>
        </xs:element>
      </xs:choice>
      <xs:attribute name="margin" type="SpacingValue">
        <xs:annotation>
          <xs:documentation>The space between the page edges and the flowing content and its regions: one value for all four sides, or two to four in the order top, right, bottom, left. Defaults to 36pt. Layers ignore it and measure from the page edges.</xs:documentation>
        </xs:annotation>
      </xs:attribute>
    </xs:complexType>
  </xs:element>

  <!-- What a rule of a markdown can set on a block of text -->
  <xs:attributeGroup name="MarkdownTextRule">
    <xs:attribute name="font"        type="xs:string"/>
    <xs:attribute name="font-size"   type="TokenScaleOrPt"/>
    <xs:attribute name="bold"        type="xs:boolean"/>
    <xs:attribute name="color"       type="Color"/>
    <xs:attribute name="align"       type="TextAlignH"/>
    <xs:attribute name="line-height" type="TokenScaleOrFactor"/>
    <xs:attribute name="padding"     type="SpacingOrToken"/>
    <xs:attribute name="background"  type="Fill"/>
    <xs:attribute name="border"      type="BorderValue"/>
    <xs:attribute name="radius"      type="TokenScaleOrPt"/>
  </xs:attributeGroup>

  <!-- What a rule of a markdown can set on a run of text inside a block -->
  <xs:attributeGroup name="MarkdownSpanRule">
    <xs:attribute name="font"  type="xs:string"/>
    <xs:attribute name="color" type="Color"/>
  </xs:attributeGroup>

  <!-- What a rule of a markdown can set on a cell -->
  <xs:attributeGroup name="MarkdownCellRule">
    <xs:attribute name="font"       type="xs:string"/>
    <xs:attribute name="font-size"  type="TokenScaleOrPt"/>
    <xs:attribute name="bold"       type="xs:boolean"/>
    <xs:attribute name="color"      type="Color"/>
    <xs:attribute name="align"      type="TextAlignH"/>
    <xs:attribute name="padding"    type="SpacingOrToken"/>
    <xs:attribute name="background" type="Fill"/>
    <xs:attribute name="border"     type="BorderValue"/>
  </xs:attributeGroup>

  <xs:element name="markdown">
    <xs:annotation>
      <xs:documentation>Markdown as the content of a section, where a layout would go. It holds only Markdown: optional markdown-styles, which say how each part of it looks, and one markdown-content, which holds the text. The page, a header, a footer or a cover are not Markdown, so they stay in the XML: layers paint a header and a footer in the margin, and a cover or a table of contents is a section of its own. CommonMark with tables, strikethrough and footnotes, and a $ is text. Raw HTML is for an HTML output, which a PDF is not, so a tag is left out and the words in it are kept: a block such as a p or a div puts the words around it on lines of their own. Two tags are read: br breaks a line, and img shows an image, at its width and height in pixels when it has them, which Markdown's own image has no way to say. An image at a URL, in Markdown or in an img, is left out, since an image must be an asset. A heading is a bookmark, so the table of contents and the outline of the viewer fill themselves.</xs:documentation>
    </xs:annotation>
    <xs:complexType>
      <xs:sequence>
        <xs:element name="markdown-styles" minOccurs="0">
          <xs:annotation>
            <xs:documentation>How the parts of the Markdown look. A rule is named after the Markdown it styles and takes the attributes of the element it becomes, so that h1 takes what a text takes. A rule here overrides the same rule of the file that src names, which overrides the defaults: a style that is not set stays what it was. Values are the tokens' (font-size="xxl", color="primary") or plain lengths and colors, and fonts are names from assets. A built-in font needs no rule for italic and bold; an embedded font names the faces: em font="body-italic", strong font="body-bold".</xs:documentation>
          </xs:annotation>
          <xs:complexType>
            <xs:choice minOccurs="0" maxOccurs="unbounded">
              <xs:element name="h1">
                <xs:annotation><xs:documentation>A heading of level 1, written # in Markdown.</xs:documentation></xs:annotation>
                <xs:complexType><xs:attributeGroup ref="MarkdownTextRule"/></xs:complexType>
              </xs:element>
              <xs:element name="h2">
                <xs:annotation><xs:documentation>A heading of level 2, written ## in Markdown.</xs:documentation></xs:annotation>
                <xs:complexType><xs:attributeGroup ref="MarkdownTextRule"/></xs:complexType>
              </xs:element>
              <xs:element name="h3">
                <xs:annotation><xs:documentation>A heading of level 3, written ### in Markdown.</xs:documentation></xs:annotation>
                <xs:complexType><xs:attributeGroup ref="MarkdownTextRule"/></xs:complexType>
              </xs:element>
              <xs:element name="h4">
                <xs:annotation><xs:documentation>A heading of level 4, written #### in Markdown.</xs:documentation></xs:annotation>
                <xs:complexType><xs:attributeGroup ref="MarkdownTextRule"/></xs:complexType>
              </xs:element>
              <xs:element name="h5">
                <xs:annotation><xs:documentation>A heading of level 5, written ##### in Markdown.</xs:documentation></xs:annotation>
                <xs:complexType><xs:attributeGroup ref="MarkdownTextRule"/></xs:complexType>
              </xs:element>
              <xs:element name="h6">
                <xs:annotation><xs:documentation>A heading of level 6, written ###### in Markdown.</xs:documentation></xs:annotation>
                <xs:complexType><xs:attributeGroup ref="MarkdownTextRule"/></xs:complexType>
              </xs:element>
              <xs:element name="p">
                <xs:annotation><xs:documentation>A paragraph, and the words of a list item, a quote and a footnote.</xs:documentation></xs:annotation>
                <xs:complexType><xs:attributeGroup ref="MarkdownTextRule"/></xs:complexType>
              </xs:element>
              <xs:element name="code">
                <xs:annotation>
                  <xs:documentation>Code: the box of a fenced or indented block, and the run of inline code, which takes the font, the color and the background. The language of a fence is ignored, since there is no highlighting by language.</xs:documentation>
                </xs:annotation>
                <xs:complexType>
                  <xs:attribute name="font"        type="xs:string"/>
                  <xs:attribute name="font-size"   type="TokenScaleOrPt"/>
                  <xs:attribute name="color"       type="Color"/>
                  <xs:attribute name="line-height" type="TokenScaleOrFactor"/>
                  <xs:attribute name="padding"     type="SpacingOrToken"/>
                  <xs:attribute name="background"  type="Fill"/>
                  <xs:attribute name="border"      type="BorderValue"/>
                  <xs:attribute name="radius"      type="TokenScaleOrPt"/>
                  <xs:attribute name="tab-size"    type="xs:positiveInteger"/>
                </xs:complexType>
              </xs:element>
              <xs:element name="quote">
                <xs:annotation>
                  <xs:documentation>A block quote, written > in Markdown: a bar beside its content. font, font-size, color, line-height and align set the words; padding, background, border and radius the box around the bar and the words; bar-color and bar-width the bar, a strip along the left of the box: bar-width is a length or a name from the space row of the tokens.</xs:documentation>
                </xs:annotation>
                <xs:complexType>
                  <xs:attributeGroup ref="MarkdownTextRule"/>
                  <xs:attribute name="bar-color" type="Color"/>
                  <xs:attribute name="bar-width" type="TokenScaleOrPt"/>
                </xs:complexType>
              </xs:element>
              <xs:element name="li">
                <xs:annotation>
                  <xs:documentation>An item of a bullet or a numbered list. indent is the width of the marker's column and bullet the shape of a bullet list's marker, as on a list; gap goes between the blocks of an item.</xs:documentation>
                </xs:annotation>
                <xs:complexType>
                  <xs:attribute name="font"       type="xs:string"/>
                  <xs:attribute name="font-size"  type="TokenScaleOrPt"/>
                  <xs:attribute name="color"      type="Color"/>
                  <xs:attribute name="gap"        type="TokenScaleOrPt"/>
                  <xs:attribute name="padding"    type="SpacingOrToken"/>
                  <xs:attribute name="background" type="Fill"/>
                  <xs:attribute name="border"     type="BorderValue"/>
                  <xs:attribute name="indent"     type="TokenScaleOrPt"/>
                  <xs:attribute name="bullet"     type="ListBullet"/>
                </xs:complexType>
              </xs:element>
              <xs:element name="hr">
                <xs:annotation>
                  <xs:documentation>A thematic break, written --- in Markdown: a divider. color is the color of the line and thickness its thickness, a length or a name from the border row of the tokens.</xs:documentation>
                </xs:annotation>
                <xs:complexType>
                  <xs:attribute name="color"     type="Color"/>
                  <xs:attribute name="thickness" type="TokenScaleOrPt"/>
                </xs:complexType>
              </xs:element>
              <xs:element name="a">
                <xs:annotation><xs:documentation>A link, written [text](url) in Markdown.</xs:documentation></xs:annotation>
                <xs:complexType>
                  <xs:attributeGroup ref="MarkdownSpanRule"/>
                  <xs:attribute name="bold"      type="xs:boolean"/>
                  <xs:attribute name="underline" type="xs:boolean"/>
                </xs:complexType>
              </xs:element>
              <xs:element name="strong">
                <xs:annotation><xs:documentation>Strong text, written **text** in Markdown. Bold in a built-in font; an embedded font names its bold face in font.</xs:documentation></xs:annotation>
                <xs:complexType>
                  <xs:attributeGroup ref="MarkdownSpanRule"/>
                  <xs:attribute name="bold" type="xs:boolean"/>
                </xs:complexType>
              </xs:element>
              <xs:element name="em">
                <xs:annotation><xs:documentation>Emphasis, written *text* in Markdown. Italic in a built-in font; an embedded font names its italic face in font.</xs:documentation></xs:annotation>
                <xs:complexType><xs:attributeGroup ref="MarkdownSpanRule"/></xs:complexType>
              </xs:element>
              <xs:element name="del">
                <xs:annotation><xs:documentation>Struck-through text, written ~~text~~ in Markdown.</xs:documentation></xs:annotation>
                <xs:complexType>
                  <xs:attributeGroup ref="MarkdownSpanRule"/>
                  <xs:attribute name="strike" type="xs:boolean"/>
                </xs:complexType>
              </xs:element>
              <xs:element name="table">
                <xs:annotation>
                  <xs:documentation>A table. Its columns are sized by their content: a column takes the width its cells need on one line, the room that is left is shared in proportion, and a name that does not fit breaks at the edge of its cell. stripe is the color of every other row, or none; head-border is the line under the header row and row-border the line under each of the other rows, as thickness and color like border, or none. The default styles draw a line in line-muted under the header and under each row, with no stripe.</xs:documentation>
                </xs:annotation>
                <xs:complexType>
                  <xs:attribute name="border"     type="BorderValue"/>
                  <xs:attribute name="stripe"     type="Color"/>
                  <xs:attribute name="head-border" type="LineValue"/>
                  <xs:attribute name="row-border" type="LineValue"/>
                  <xs:attribute name="gap"        type="TokenScaleOrPt"/>
                  <xs:attribute name="padding"    type="SpacingOrToken"/>
                  <xs:attribute name="background" type="Fill"/>
                </xs:complexType>
              </xs:element>
              <xs:element name="th">
                <xs:annotation><xs:documentation>A cell of a table's header row.</xs:documentation></xs:annotation>
                <xs:complexType><xs:attributeGroup ref="MarkdownCellRule"/></xs:complexType>
              </xs:element>
              <xs:element name="td">
                <xs:annotation><xs:documentation>A cell of a table's other rows.</xs:documentation></xs:annotation>
                <xs:complexType><xs:attributeGroup ref="MarkdownCellRule"/></xs:complexType>
              </xs:element>
            </xs:choice>
            <xs:attribute name="src" type="xs:string">
              <xs:annotation>
                <xs:documentation>A file of rules, whose root is a markdown-styles. The rules written here override its rules. The engine reads no files: the SDK, the command line or the extension reads it, as it reads the src of a font or an image.</xs:documentation>
              </xs:annotation>
            </xs:attribute>
          </xs:complexType>
        </xs:element>
        <xs:element name="markdown-content">
          <xs:annotation>
            <xs:documentation>The Markdown. It comes from the data, with data-value, or is written inline, best in a CDATA section, because Markdown uses &lt; and &amp; freely. The common indent of the lines is removed first, so that indenting the XML does not make a code block of it. An inline text is what a document with no data shows. A Markdown that begins with --- ... --- front matter does not draw it.</xs:documentation>
          </xs:annotation>
          <xs:complexType mixed="true">
            <xs:attribute name="data-value" type="xs:string">
              <xs:annotation>
                <xs:documentation>The path in the data of a string that holds the Markdown, as data-value fills a text. A path the data lacks leaves it empty.</xs:documentation>
              </xs:annotation>
            </xs:attribute>
          </xs:complexType>
        </xs:element>
      </xs:sequence>
      <xs:attribute name="margin" type="SpacingValue">
        <xs:annotation>
          <xs:documentation>The space between the page edges and the Markdown: one value for all four sides, or two to four in the order top, right, bottom, left. Defaults to 36pt. A layer draws a header or a footer in it.</xs:documentation>
        </xs:annotation>
      </xs:attribute>
      <xs:attribute name="font" type="xs:string">
        <xs:annotation>
          <xs:documentation>The font of the Markdown, which a rule can change. Defaults to the document's.</xs:documentation>
        </xs:annotation>
      </xs:attribute>
      <xs:attribute name="font-size" type="TokenScaleOrPt">
        <xs:annotation>
          <xs:documentation>The size of the text of the Markdown, which a rule can change. Defaults to 11pt.</xs:documentation>
        </xs:annotation>
      </xs:attribute>
      <xs:attribute name="color" type="Color">
        <xs:annotation>
          <xs:documentation>The color of the text of the Markdown, which a rule can change. Defaults to the text token.</xs:documentation>
        </xs:annotation>
      </xs:attribute>
      <xs:attribute name="gap" type="TokenScaleOrPt">
        <xs:annotation>
          <xs:documentation>The space between the blocks: headings, paragraphs, lists, code, quotes, tables and images. Default none.</xs:documentation>
        </xs:annotation>
      </xs:attribute>
      <xs:attribute name="bookmarks" type="MarkdownBookmarks">
        <xs:annotation>
          <xs:documentation>How many levels of headings become bookmarks, for the outline of the viewer and the table of contents: n keeps the levels 1 to n, 0 none. Default 6.</xs:documentation>
        </xs:annotation>
      </xs:attribute>
      <xs:attribute name="debug" type="xs:boolean"/>
    </xs:complexType>
  </xs:element>

  <!-- document: holds default page settings; contains one or more sections.
       layout and layers go inside a section, never directly in document: the engine
       stops with "unexpected element in <document>". -->
  <xs:element name="document">
    <xs:annotation>
      <xs:documentation>The whole document, and the page settings every section starts from: size, orientation, background and font. It holds an optional meta element, an optional output element, optional attachments and at least one section.</xs:documentation>
    </xs:annotation>
    <xs:complexType>
      <xs:sequence>
        <xs:element ref="meta" minOccurs="0"/>
        <xs:element ref="output" minOccurs="0"/>
        <xs:element ref="attachments" minOccurs="0"/>
        <xs:element ref="section" maxOccurs="unbounded"/>
      </xs:sequence>
      <xs:attribute name="font"        type="xs:string"/>
      <xs:attribute name="size"        type="PageSize"/>
      <xs:attribute name="orientation" type="Orientation"/>
      <xs:attribute name="background"  type="Fill"/>
      <xs:attribute name="debug"       type="xs:boolean"/>
      <xs:attribute name="footnote-counter" type="FootnoteCounter">
        <xs:annotation>
          <xs:documentation>Where the numbers of the footnotes start over: on every page, in every section (the default), or never, so that they run on through the document. A section's own footnote-counter overrides it.</xs:documentation>
        </xs:annotation>
      </xs:attribute>
    </xs:complexType>
  </xs:element>

  <!-- section: a content boundary with its own auto-pagination.
       Attributes override document-level defaults for this section only.
       title is read but not yet written to the PDF: there is no outline.
       Layers, then at most one layout, then layers; document order = paint order.
       The layers after the layout sit in an optional group with it, so that a layer
       matches only one particle (XSD 1.0's unique particle attribution). -->
  <xs:element name="section">
    <xs:annotation>
      <xs:documentation>A run of pages with its own settings, which override the document's. Each section paginates on its own. A bookmark as its first child marks its first page. It holds layers and at most one layout or one markdown, painted in the order they are written: layers before the layout paint under it, and layers after it paint over it. A section with neither is one page. Its title is accepted but not used: the outline takes its entries from bookmarks.</xs:documentation>
    </xs:annotation>
    <xs:complexType>
      <xs:sequence>
        <xs:element ref="bookmark" minOccurs="0"/>
        <xs:element ref="layer" minOccurs="0" maxOccurs="unbounded"/>
        <xs:sequence minOccurs="0">
          <xs:choice>
            <xs:element ref="layout"/>
            <xs:element ref="markdown"/>
          </xs:choice>
          <xs:element ref="layer" minOccurs="0" maxOccurs="unbounded"/>
        </xs:sequence>
      </xs:sequence>
      <xs:attribute name="size"        type="PageSize"/>
      <xs:attribute name="orientation" type="Orientation"/>
      <xs:attribute name="background"  type="Fill"/>
      <xs:attribute name="title"       type="xs:string"/>
      <xs:attribute name="debug"       type="xs:boolean"/>
      <xs:attribute name="type"        type="SectionType">
        <xs:annotation>
          <xs:documentation>toc makes the section the document's table of contents. It is laid out after the other sections, with the data $toc: one entry per bookmark outside it, with index, level, label, page, anchor and indent. Repeat an element over it with data-source="$toc". One section per document may be a table of contents.</xs:documentation>
        </xs:annotation>
      </xs:attribute>
      <xs:attribute name="footnote-counter" type="FootnoteCounter">
        <xs:annotation>
          <xs:documentation>Where the numbers of the footnotes in this section start over: on every page, in this section (the default), or never, so that they run on from the earlier sections that number across the document. Overrides the document's.</xs:documentation>
        </xs:annotation>
      </xs:attribute>
      <xs:attribute name="toc-indent-step" type="TokenScaleOrPt">
        <xs:annotation>
          <xs:documentation>In a table of contents, the left padding an entry gets for each level below the first. Defaults to 12pt.</xs:documentation>
        </xs:annotation>
      </xs:attribute>
    </xs:complexType>
  </xs:element>

  <!-- Root element -->
  <xs:element name="lpdf">
    <xs:complexType>
      <xs:sequence>
        <xs:element ref="assets"   minOccurs="0"/>
        <xs:element ref="tokens"   minOccurs="0"/>
        <xs:element ref="document"/>
      </xs:sequence>
      <xs:attribute name="version" type="xs:positiveInteger" use="required"/>
    </xs:complexType>
  </xs:element>


  <!-- ============================================================
       Layout elements
  ============================================================ -->

  <xs:element name="column">
    <xs:annotation>
      <xs:documentation>Places children top to bottom, each at the full width, with gap between them. Can split across pages between children.</xs:documentation>
    </xs:annotation>
    <xs:complexType>
      <xs:sequence>
        <xs:group ref="LayoutContent" minOccurs="0" maxOccurs="unbounded"/>
      </xs:sequence>
      <xs:attributeGroup ref="BoxAttrs"/>
      <xs:attribute name="align"   type="AlignFull"/>
      <xs:attribute name="justify" type="Justify"/>
      <xs:attributeGroup ref="WidthAttr"/>
    </xs:complexType>
  </xs:element>

  <xs:element name="row">
    <xs:annotation>
      <xs:documentation>Children side by side, continuing on the next line when they run out of width. A child with width set to fill takes what its line leaves; justify set to between puts a line's first child at the left edge, its last at the right and the others evenly between. Splits across pages between lines.</xs:documentation>
    </xs:annotation>
    <xs:complexType>
      <xs:sequence>
        <xs:group ref="LayoutContent" minOccurs="0" maxOccurs="unbounded"/>
      </xs:sequence>
      <xs:attributeGroup ref="BoxAttrs"/>
      <xs:attribute name="align"   type="AlignFull"/>
      <xs:attribute name="justify" type="Justify"/>
      <xs:attributeGroup ref="WidthAttr"/>
    </xs:complexType>
  </xs:element>

  <xs:element name="list">
    <xs:annotation>
      <xs:documentation>A list of items, each with a marker: a bullet drawn as a shape, or a number the engine gives. The items go top to bottom with gap between them, each one a li, and a list nests inside an item. The words of an item start indent from the list's left edge, at every level. A long item splits across pages through the line the page ends in, and its marker stays with the first part.</xs:documentation>
    </xs:annotation>
    <xs:complexType>
      <xs:sequence>
        <xs:element ref="li" minOccurs="0" maxOccurs="unbounded"/>
      </xs:sequence>
      <xs:attributeGroup ref="BoxAttrs"/>
      <xs:attribute name="type" type="ListType">
        <xs:annotation>
          <xs:documentation>bullet marks each item with a shape, number with a number. Default bullet.</xs:documentation>
        </xs:annotation>
      </xs:attribute>
      <xs:attribute name="format" type="ListFormat">
        <xs:annotation>
          <xs:documentation>How a number list writes its numbers: decimal (1, 2, 3), lower-alpha (a, b, c, then aa, ab), upper-alpha (A, B, C), lower-roman (i, ii, iii) or upper-roman (I, II, III). A number that a letter or a numeral can't write, below 1 or past 3999 for a numeral, is written in decimal. Default decimal.</xs:documentation>
        </xs:annotation>
      </xs:attribute>
      <xs:attribute name="start" type="xs:integer">
        <xs:annotation>
          <xs:documentation>The number of a number list's first item, to continue a list that something cut in two. Default 1.</xs:documentation>
        </xs:annotation>
      </xs:attribute>
      <xs:attribute name="prefix" type="xs:string">
        <xs:annotation>
          <xs:documentation>Text before each number of a number list: prefix="(" and suffix=")" write (a). Default none.</xs:documentation>
        </xs:annotation>
      </xs:attribute>
      <xs:attribute name="suffix" type="xs:string">
        <xs:annotation>
          <xs:documentation>Text after each number of a number list: suffix=")" writes a). Default a full stop, so a number is written 1.</xs:documentation>
        </xs:annotation>
      </xs:attribute>
      <xs:attribute name="bullet" type="ListBullet">
        <xs:annotation>
          <xs:documentation>The shape that marks the items of a bullet list. Without it a list uses a disc, a list inside a bullet list a circle, and one inside that a square, then the three again.</xs:documentation>
        </xs:annotation>
      </xs:attribute>
      <xs:attribute name="indent" type="TokenScaleOrPt">
        <xs:annotation>
          <xs:documentation>The width of the marker's column: the words of an item start this far from the list's left edge, and a list inside an item starts there too. The marker is set at the right of its column, so 9. and 10. end together, and a marker wider than the column is not made to fit. The same length at every level. Default 24pt.</xs:documentation>
        </xs:annotation>
      </xs:attribute>
      <xs:attributeGroup ref="WidthAttr"/>
    </xs:complexType>
  </xs:element>

  <xs:element name="li">
    <xs:annotation>
      <xs:documentation>One item of a list: a box that holds what a layout holds, such as a text, an image, a table or another list, and sits beside the item's marker. The words go in a text. data-source repeats the item once for each entry of the data, and the numbers of a number list follow what is made. The item's own box (padding, background, border) surrounds the marker and the content, and its gap goes between its children: the gap of the list, unless the item sets one.</xs:documentation>
    </xs:annotation>
    <xs:complexType>
      <xs:sequence>
        <xs:group ref="LayoutContent" minOccurs="0" maxOccurs="unbounded"/>
      </xs:sequence>
      <xs:attributeGroup ref="BoxAttrs"/>
      <xs:attribute name="checked" type="xs:boolean">
        <xs:annotation>
          <xs:documentation>Makes the item's marker a checkbox in place of the bullet or the number: an outline in the line color, with a tick in the color of the item's words when this is true, and empty when it is false. The words start where those of a bullet do, and an item of a number list still takes its number. An item without it keeps its bullet or number. A task item of a Markdown, - [ ] or - [x], is one.</xs:documentation>
        </xs:annotation>
      </xs:attribute>
    </xs:complexType>
  </xs:element>

  <xs:element name="grid">
    <xs:annotation>
      <xs:documentation>Fills a fixed number of equal columns from left to right, then starts a new row. A row never splits across pages. For data with a header row, use table.</xs:documentation>
    </xs:annotation>
    <xs:complexType>
      <xs:sequence>
        <xs:group ref="LayoutContent" minOccurs="0" maxOccurs="unbounded"/>
      </xs:sequence>
      <xs:attributeGroup ref="BoxAttrs"/>
      <xs:attributeGroup ref="WidthAttr"/>
      <xs:attribute name="col-width" type="TokenScaleOrPt"/>
      <xs:attribute name="cols">
        <xs:simpleType>
          <xs:restriction base="xs:positiveInteger">
            <xs:minInclusive value="1"/>
            <xs:maxInclusive value="12"/>
          </xs:restriction>
        </xs:simpleType>
      </xs:attribute>
    </xs:complexType>
  </xs:element>

  <xs:element name="frame">
    <xs:annotation>
      <xs:documentation>A box around a single child, which it centres. Never splits across pages: if it does not fit, the whole box moves to the next page.</xs:documentation>
    </xs:annotation>
    <xs:complexType>
      <xs:sequence>
        <xs:group ref="LayoutContent" minOccurs="0" maxOccurs="1"/>
      </xs:sequence>
      <xs:attributeGroup ref="FrameBoxAttrs"/>
      <xs:attributeGroup ref="WidthAttr"/>
    </xs:complexType>
  </xs:element>

  <xs:element name="code">
    <xs:annotation>
      <xs:documentation>Code, or any text whose spaces and lines matter, in a box. The text is kept as it is written: every space, and a new line wherever one is written, except the line break after the start tag and the indent of the line the end tag stands on. A line longer than the box wraps at a space, and a word with none breaks at the last character that fits, so nothing is cut off. A tab fills to the next multiple of tab-size columns. The box fills the width and grows with its lines, in Courier on a light tint with padding m unless font, background and padding say otherwise. It holds text and span children, which color or style parts of it. It splits across pages between lines, and each part is drawn in its own box. A code element is a column around one text, so the text takes its font, size and color from font, font-size and color.</xs:documentation>
    </xs:annotation>
    <xs:complexType mixed="true">
      <xs:choice minOccurs="0" maxOccurs="unbounded">
        <xs:element ref="span"/>
      </xs:choice>
      <xs:attributeGroup ref="FrameBoxAttrs"/>
      <xs:attributeGroup ref="WidthAttr"/>
      <xs:attribute name="tab-size">
        <xs:annotation>
          <xs:documentation>How many columns a tab fills to: it moves the next character to the next multiple of this many characters from the start of the line. Default 4.</xs:documentation>
        </xs:annotation>
        <xs:simpleType>
          <xs:restriction base="xs:positiveInteger">
            <xs:minInclusive value="1"/>
            <xs:maxInclusive value="16"/>
          </xs:restriction>
        </xs:simpleType>
      </xs:attribute>
      <xs:attribute name="line-height" type="TokenScaleOrFactor">
        <xs:annotation>
          <xs:documentation>The distance between lines, as a factor of the font size: a number above 0, such as 1.5, or a name from the line-height row of the tokens. Default 1.2, which is the token m.</xs:documentation>
        </xs:annotation>
      </xs:attribute>
      <xs:attribute name="widows">
        <xs:annotation>
          <xs:documentation>The fewest lines of the code that may stand alone at the top of the next page when it splits. Default 2. If fewer would be left, lines move from the first page to the next; 1 turns the protection off.</xs:documentation>
        </xs:annotation>
        <xs:simpleType>
          <xs:restriction base="xs:positiveInteger">
            <xs:minInclusive value="1"/>
            <xs:maxInclusive value="10"/>
          </xs:restriction>
        </xs:simpleType>
      </xs:attribute>
      <xs:attribute name="orphans">
        <xs:annotation>
          <xs:documentation>The fewest lines of the code that may stand alone at the bottom of a page when it splits. Default 2. If fewer would fit, the whole code moves to the next page; 1 turns the protection off.</xs:documentation>
        </xs:annotation>
        <xs:simpleType>
          <xs:restriction base="xs:positiveInteger">
            <xs:minInclusive value="1"/>
            <xs:maxInclusive value="10"/>
          </xs:restriction>
        </xs:simpleType>
      </xs:attribute>
    </xs:complexType>
  </xs:element>

  <xs:element name="link">
    <xs:complexType>
      <xs:sequence>
        <xs:group ref="LayoutContent" minOccurs="0" maxOccurs="unbounded"/>
      </xs:sequence>
      <xs:attribute name="href"   type="xs:anyURI" use="required">
        <xs:annotation>
          <xs:documentation>Where the link goes: a URL, or #id to jump to the bookmark with that id. In an entry of a table of contents, # alone jumps to that entry's bookmark.</xs:documentation>
        </xs:annotation>
      </xs:attribute>
      <xs:attribute name="gap"    type="SpacingOrToken"/>
      <xs:attributeGroup ref="WidthAttr"/>
      <xs:attribute name="height" type="HeightValue"/>
      <xs:attribute name="debug"  type="xs:boolean"/>
      <xs:attributeGroup ref="DataBindingAttrs"/>
      <xs:attributeGroup ref="DataHrefAttr"/>
    </xs:complexType>
  </xs:element>

  <xs:element name="bookmark">
    <xs:annotation>
      <xs:documentation>An entry of the PDF's outline, the bookmark panel of a viewer, and a target for links with href="#id". It draws nothing and marks the element that follows it, so it is never left at the bottom of a page apart from that element. Directly inside a section, it marks the section's first page.</xs:documentation>
    </xs:annotation>
    <xs:complexType>
      <xs:attribute name="label" type="xs:string" use="required">
        <xs:annotation>
          <xs:documentation>The text of the entry, in the outline and in a table of contents.</xs:documentation>
        </xs:annotation>
      </xs:attribute>
      <xs:attribute name="level" type="BookmarkLevel">
        <xs:annotation>
          <xs:documentation>Depth in the outline, 1 to 6. Defaults to 1. An entry nests under the closest entry before it with a lower level.</xs:documentation>
        </xs:annotation>
      </xs:attribute>
      <xs:attribute name="id" type="xs:string">
        <xs:annotation>
          <xs:documentation>The name links use to jump here, as href="#id". Leave it out to make it from the label: lowercase, with other characters than letters and digits turned into hyphens, and -2, -3 added when an earlier bookmark has it. Two bookmarks may not have the same id.</xs:documentation>
        </xs:annotation>
      </xs:attribute>
    </xs:complexType>
  </xs:element>

  <xs:element name="divider">
    <xs:complexType>
      <xs:attribute name="direction">
        <xs:simpleType>
          <xs:restriction base="xs:string">
            <xs:enumeration value="horizontal"/>
            <xs:enumeration value="vertical"/>
          </xs:restriction>
        </xs:simpleType>
      </xs:attribute>
      <xs:attribute name="color"     type="Color"/>
      <xs:attribute name="thickness" type="TokenScaleOrPt"/>
      <xs:attributeGroup ref="WidthAttr"/>
      <xs:attribute name="debug"     type="xs:boolean"/>
      <xs:attributeGroup ref="DataBindingAttrs"/>
      <xs:attributeGroup ref="DataColorAttr"/>
    </xs:complexType>
  </xs:element>

  <xs:element name="span">
    <xs:complexType mixed="true">
      <xs:attribute name="font"      type="xs:string"/>
      <xs:attribute name="bold"      type="xs:boolean"/>
      <xs:attribute name="color"     type="Color"/>
      <xs:attribute name="href"      type="xs:anyURI">
        <xs:annotation>
          <xs:documentation>Makes the span a link: a URL, or #id to jump to the bookmark with that id. In an entry of a table of contents, # alone jumps to that entry's bookmark.</xs:documentation>
        </xs:annotation>
      </xs:attribute>
      <xs:attribute name="underline" type="xs:boolean"/>
      <xs:attribute name="strike"    type="xs:boolean"/>
    </xs:complexType>
  </xs:element>

  <xs:element name="code-span">
    <xs:annotation>
      <xs:documentation>A run of code inside a text: its words in Courier on a light tint, the tint drawn behind them. It is the inline twin of code, and like a span it is not broken inside, so it goes to the next line whole, and a run longer than a whole line breaks at the last character that fits, so nothing runs past the box. White space in it collapses as in the text around it.</xs:documentation>
    </xs:annotation>
    <xs:complexType mixed="true">
      <xs:attribute name="font"       type="xs:string"/>
      <xs:attribute name="color"      type="Color"/>
      <xs:attribute name="background" type="Color">
        <xs:annotation>
          <xs:documentation>The tint drawn behind the run. Default #f3f4f6.</xs:documentation>
        </xs:annotation>
      </xs:attribute>
    </xs:complexType>
  </xs:element>

  <xs:element name="fn">
    <xs:annotation>
      <xs:documentation>A footnote. Its place in the text shows a small raised number, and its words go at the bottom of the page where that number lands, under a short rule, in the order of the numbers. The engine numbers the notes: footnote-counter on the document or the section says where the numbers start over. A page with notes has less room for the text, so the line with the number moves to the next page when its note does not fit. The note holds words and spans. Only a text of the layout may hold one: a text-at, a table and a region cannot.</xs:documentation>
    </xs:annotation>
    <xs:complexType mixed="true">
      <xs:choice minOccurs="0" maxOccurs="unbounded">
        <xs:element ref="span"/>
      </xs:choice>
    </xs:complexType>
  </xs:element>

  <xs:element name="img">
    <xs:annotation>
      <xs:documentation>An image. It is never stretched. With only a width or a height, the other follows the image's proportions. With both, they are a maximum: the image takes the largest size that fits in them, and its box becomes that size, which the parent's align places. To put images of different shapes in slots of one size, wrap each in a frame of that size. With neither, the image has its natural size.</xs:documentation>
    </xs:annotation>
    <xs:complexType>
      <!-- <img> takes a slot or a length for its height, not HeightMode (fill/full) -->
      <xs:attributeGroup ref="ImgCore"/>
      <xs:attribute name="height"     type="TokenScaleOrPt"/>
      <xs:attributeGroup ref="WidthAttr"/>
      <xs:attribute name="font"       type="xs:string"/>
      <xs:attribute name="font-size"  type="TokenScaleOrPt"/>
      <xs:attribute name="gap"        type="TokenScaleOrPt"/>
      <xs:attribute name="padding"    type="SpacingOrToken"/>
      <xs:attribute name="background" type="Color"/>
      <xs:attribute name="border"     type="BorderValue"/>
      <xs:attribute name="radius"     type="TokenScaleOrPt"/>
      <xs:attribute name="paginate"   type="Paginate"/>
      <xs:attribute name="debug"      type="xs:boolean"/>
      <xs:attributeGroup ref="DataBindingAttrs"/>
    </xs:complexType>
  </xs:element>

  <xs:element name="barcode">
    <xs:annotation>
      <xs:documentation>A QR code, a Code 128 or an EAN-13. It is never stretched. With only a width or a height, the other follows the barcode's proportions. With both, they are a maximum: the barcode takes the largest size that fits in them, and its box becomes that size, which the parent's align places. To put barcodes in slots of one size, wrap each in a frame of that size.</xs:documentation>
    </xs:annotation>
    <xs:complexType>
      <xs:attributeGroup ref="BarcodeCore"/>
      <xs:attribute name="height" type="TokenScaleOrPt">
        <xs:annotation>
          <xs:documentation>Height of the whole barcode, a length or a name from the height row of the tokens, with the digits of hrt inside it: they take the bottom 12pt and the bars the rest. A barcode is never stretched. With only a height, the width follows the barcode's proportions. With both width and height, they are a maximum: the barcode takes the largest size that fits in them, and its box becomes that size. A QR code is square, so it takes the smaller of the two. Without a size, a code128 is as wide as its bars at 1pt per module and its bars are 40pt high, and an ean13 is the standard symbol, 0.33mm per module and bars 22.85mm high. The digits of hrt add 12pt to either.</xs:documentation>
        </xs:annotation>
      </xs:attribute>
      <xs:attributeGroup ref="BarcodeStyle"/>
      <xs:attributeGroup ref="WidthAttr"/>
      <xs:attribute name="paginate"   type="Paginate"/>
      <xs:attribute name="debug"      type="xs:boolean"/>
      <xs:attributeGroup ref="DataBindingAttrs"/>
    </xs:complexType>
  </xs:element>

  <xs:element name="shape">
    <xs:annotation>
      <xs:documentation>A rectangle, a circle or an ellipse in the layout, for a status dot, a color swatch or a progress bar. It takes its box in the flow as an image does, with no children, and is drawn centered in that box, which the parent's align places. A rect and an ellipse need a width and a height, and a circle an r. A shape with no fill and no stroke draws nothing, but keeps its box. A stroke is centered on the edge of the box, so half of it lies outside. To put a shape at a place on the page, use a rect, circle or ellipse in a layer.</xs:documentation>
    </xs:annotation>
    <xs:complexType>
      <xs:attribute name="type" use="required">
        <xs:simpleType>
          <xs:restriction base="xs:string">
            <xs:enumeration value="rect"/>
            <xs:enumeration value="circle"/>
            <xs:enumeration value="ellipse"/>
          </xs:restriction>
        </xs:simpleType>
      </xs:attribute>
      <xs:attribute name="width" type="TokenScaleOrPt">
        <xs:annotation>
          <xs:documentation>Width of a rect or an ellipse, a length or a name from the width row of the tokens. A circle takes r instead.</xs:documentation>
        </xs:annotation>
      </xs:attribute>
      <xs:attribute name="height" type="TokenScaleOrPt">
        <xs:annotation>
          <xs:documentation>Height of a rect or an ellipse, a length or a name from the height row of the tokens. A circle takes r instead.</xs:documentation>
        </xs:annotation>
      </xs:attribute>
      <xs:attribute name="r" type="PtValue">
        <xs:annotation>
          <xs:documentation>Radius of a circle. Its box is the square of side 2r.</xs:documentation>
        </xs:annotation>
      </xs:attribute>
      <xs:attribute name="radius" type="TokenScaleOrPt">
        <xs:annotation>
          <xs:documentation>Rounding of the corners of a rect. A circle and an ellipse are round already.</xs:documentation>
        </xs:annotation>
      </xs:attribute>
      <xs:attributeGroup ref="CanvasFillStrokeAttrs"/>
      <xs:attribute name="opacity" type="OpacityValue">
        <xs:annotation>
          <xs:documentation>How opaque the shape is, from 0 to 1. Default 1.</xs:documentation>
        </xs:annotation>
      </xs:attribute>
      <xs:attribute name="debug" type="xs:boolean"/>
      <xs:attributeGroup ref="DataBindingAttrs"/>
      <xs:attributeGroup ref="DataFillAttr"/>
    </xs:complexType>
  </xs:element>

  <xs:element name="text">
    <xs:annotation>
      <xs:documentation>A block of wrapping text. Use span children to style parts of it, and fn children for footnotes. Splits across pages between lines.</xs:documentation>
    </xs:annotation>
    <xs:complexType mixed="true">
      <xs:choice minOccurs="0" maxOccurs="unbounded">
        <xs:element ref="span"/>
        <xs:element ref="code-span"/>
        <xs:element ref="fn"/>
      </xs:choice>
      <xs:attributeGroup ref="TextCore"/>
      <xs:attributeGroup ref="WidthAttr"/>
      <xs:attribute name="widows">
        <xs:annotation>
          <xs:documentation>The fewest lines of the text that may stand alone at the top of the next page when it splits. Default 2. If fewer would be left, lines move from the first page to the next; 1 turns the protection off.</xs:documentation>
        </xs:annotation>
        <xs:simpleType>
          <xs:restriction base="xs:positiveInteger">
            <xs:minInclusive value="1"/>
            <xs:maxInclusive value="10"/>
          </xs:restriction>
        </xs:simpleType>
      </xs:attribute>
      <xs:attribute name="orphans">
        <xs:annotation>
          <xs:documentation>The fewest lines of the text that may stand alone at the bottom of a page when it splits. Default 2. If fewer would fit, the whole text moves to the next page; 1 turns the protection off. When no split can keep both widows and orphans, even on an empty page, the text splits where the lines fit.</xs:documentation>
        </xs:annotation>
        <xs:simpleType>
          <xs:restriction base="xs:positiveInteger">
            <xs:minInclusive value="1"/>
            <xs:maxInclusive value="10"/>
          </xs:restriction>
        </xs:simpleType>
      </xs:attribute>
      <xs:attribute name="capture" type="xs:string">
        <xs:annotation>
          <xs:documentation>Records the words of this text under a name as the pages are filled, so a text with capture-ref in a header or a footer can show them. Put it on a heading in the flow. The page that holds the text counts it, the words above it on that page included, and a text that splits across pages is recorded on the page where it starts. A text cannot have both capture and capture-ref.</xs:documentation>
        </xs:annotation>
      </xs:attribute>
      <xs:attribute name="capture-ref" type="xs:string">
        <xs:annotation>
          <xs:documentation>Shows what was captured under this name, as of the page the text is drawn on, in place of words of its own. Put it in a region. It takes the lines it may use, one unless max-lines says more, whatever it shows, so a header or a footer does not grow with its value; a longer value is cut, and ends in dots with ellipsis. On a page where nothing was captured it shows the latest value of an earlier page of the section, and capture-fallback before any.</xs:documentation>
        </xs:annotation>
      </xs:attribute>
      <xs:attribute name="capture-mode" type="CaptureMode">
        <xs:annotation>
          <xs:documentation>Which of the texts captured under the name on this page the text shows: the first or the last. Default last. Only for a text with capture-ref.</xs:documentation>
        </xs:annotation>
      </xs:attribute>
      <xs:attribute name="capture-fallback" type="xs:string">
        <xs:annotation>
          <xs:documentation>What the text shows until something has been captured in the section. Default: nothing. Only for a text with capture-ref.</xs:documentation>
        </xs:annotation>
      </xs:attribute>
      <xs:attribute name="paginate"  type="Paginate"/>
      <xs:attribute name="debug"     type="xs:boolean"/>
      <xs:attributeGroup ref="DataBindingAttrs"/>
    </xs:complexType>
  </xs:element>

  <!-- ============================================================
       Table elements
  ============================================================ -->

  <!-- <td>: a table cell — container equivalent to column -->
  <xs:element name="td">
    <xs:complexType>
      <xs:sequence>
        <xs:group ref="LayoutContent" minOccurs="0" maxOccurs="unbounded"/>
      </xs:sequence>
      <xs:attributeGroup ref="BoxAttrs"/>
      <xs:attribute name="colspan">
        <xs:annotation>
          <xs:documentation>How many of the table's columns the cell spans. It is as wide as those columns and the gaps between them, and the cells after it in the row start at the column after its last. A row whose cells span more columns than the table's cols names is an error; a row with fewer leaves its last columns empty. It changes widths only: row heights and page breaks work as before. Default 1.</xs:documentation>
        </xs:annotation>
        <xs:simpleType>
          <xs:restriction base="xs:positiveInteger">
            <xs:minInclusive value="1"/>
          </xs:restriction>
        </xs:simpleType>
      </xs:attribute>
      <xs:attribute name="rowspan">
        <xs:annotation>
          <xs:documentation>How many rows the cell spans, its own included. It is as tall as those rows and the gaps between them, and the rows under it leave its columns out: their cells start at the first free columns. If the cell's content is taller than the rows are together, the last of them grows by the difference. A row with a cell too many for the free columns, and a span that runs past the last row of the table, are errors; a thead is one row and takes no rowspan. The rows a cell spans stay on one page: the group moves to the next page whole when it does not fit, and one taller than a page is clipped at the page's end. Default 1.</xs:documentation>
        </xs:annotation>
        <xs:simpleType>
          <xs:restriction base="xs:positiveInteger">
            <xs:minInclusive value="1"/>
          </xs:restriction>
        </xs:simpleType>
      </xs:attribute>
      <xs:attribute name="align"  type="Align"/>
      <xs:attribute name="valign">
        <xs:simpleType>
          <xs:restriction base="xs:string">
            <xs:enumeration value="top"/>
            <xs:enumeration value="middle"/>
            <xs:enumeration value="bottom"/>
          </xs:restriction>
        </xs:simpleType>
      </xs:attribute>
    </xs:complexType>
  </xs:element>

  <!-- <thead>: header row — repeated at the top of each new page -->
  <xs:element name="thead">
    <xs:complexType>
      <xs:sequence>
        <xs:element ref="td" minOccurs="1" maxOccurs="unbounded"/>
      </xs:sequence>
      <xs:attribute name="background" type="Fill"/>
      <xs:attributeGroup ref="DataBindingAttrs"/>
    </xs:complexType>
  </xs:element>

  <!-- <tr>: a data row -->
  <xs:element name="tr">
    <xs:complexType>
      <xs:sequence>
        <xs:element ref="td" minOccurs="1" maxOccurs="unbounded"/>
      </xs:sequence>
      <xs:attribute name="keep" type="RowKeep">
        <xs:annotation>
          <xs:documentation>with-next keeps the row on the same page as the row after it. A run of rows that each say with-next, and the row that ends it, move to the next page together when a page break would fall inside them. A run taller than a page breaks where its rows fit, as if it had no keep. Rows are never split, and a header is never left alone at the bottom of a page, with or without this.</xs:documentation>
        </xs:annotation>
      </xs:attribute>
      <xs:attribute name="background" type="Fill"/>
      <xs:attributeGroup ref="DataBindingAttrs"/>
    </xs:complexType>
  </xs:element>

  <!-- <table>: tabular layout with explicit column widths -->
  <xs:element name="table">
    <xs:annotation>
      <xs:documentation>Rows and cells in columns whose widths are set by cols. The thead row repeats at the top of every page, and rows move between pages whole.</xs:documentation>
    </xs:annotation>
    <xs:complexType>
      <xs:sequence>
        <xs:element ref="thead" minOccurs="0" maxOccurs="1"/>
        <xs:element ref="tr"    minOccurs="0" maxOccurs="unbounded"/>
      </xs:sequence>
      <!-- cols: space-separated column widths — fr, pt, % units.
           Example: "2fr 1fr 120pt 20%" -->
      <xs:attribute name="cols"       type="xs:string" use="required">
        <xs:annotation>
          <xs:documentation>Column widths, separated by spaces, in fr, pt or % units, or auto: for example 2fr 1fr 120pt 20%. An auto column takes the width its cells need on one line, and the auto columns share what the pt and % columns leave, in proportion to what they need. When they do not fit, each keeps at least its longest word, and when not even those fit, the longest are cut and a short column keeps its width. auto and fr cannot be in one table: use pt or % for the fixed columns. For example auto 90pt 60pt.</xs:documentation>
        </xs:annotation>
      </xs:attribute>
      <xs:attribute name="border"     type="BorderValue">
        <xs:annotation>
          <xs:documentation>A grid: a line around every cell, as thickness and color, for example 1pt #cccccc.</xs:documentation>
        </xs:annotation>
      </xs:attribute>
      <xs:attribute name="stripe"     type="Color">
        <xs:annotation>
          <xs:documentation>The background of every other row below the header, or none.</xs:documentation>
        </xs:annotation>
      </xs:attribute>
      <xs:attribute name="head-border" type="LineValue">
        <xs:annotation>
          <xs:documentation>The line under the header row, across the table, as thickness and color like border, or none: for example xs line.</xs:documentation>
        </xs:annotation>
      </xs:attribute>
      <xs:attribute name="row-border" type="LineValue">
        <xs:annotation>
          <xs:documentation>The line under each row, across the table, as thickness and color like border, or none: for example xs line-muted. Under the header row, head-border takes its place when it is set. A line stops where a cell spans on into the next row.</xs:documentation>
        </xs:annotation>
      </xs:attribute>
      <xs:attribute name="gap"        type="TokenScaleOrPt"/>
      <xs:attribute name="padding"    type="SpacingOrToken"/>
      <xs:attribute name="background" type="Fill"/>
      <xs:attributeGroup ref="WidthAttr"/>
      <xs:attribute name="height"     type="HeightValue"/>
      <xs:attribute name="paginate"   type="Paginate"/>
      <xs:attribute name="debug"      type="xs:boolean"/>
      <xs:attributeGroup ref="DataBindingAttrs"/>
    </xs:complexType>
  </xs:element>

  <!-- ============================================================
       Form field element
  ============================================================ -->

  <xs:element name="field">
    <xs:complexType>
      <xs:attribute name="type" use="required">
        <xs:simpleType>
          <xs:restriction base="xs:string">
            <xs:enumeration value="text"/>
            <xs:enumeration value="checkbox"/>
            <xs:enumeration value="dropdown"/>
            <xs:enumeration value="radio"/>
            <xs:enumeration value="button"/>
          </xs:restriction>
        </xs:simpleType>
      </xs:attribute>
      <xs:attribute name="name"       type="xs:string" use="required"/>
      <xs:attribute name="value"      type="xs:string"/>
      <xs:attribute name="label"      type="xs:string"/>
      <xs:attribute name="options"    type="xs:string"/>
      <xs:attribute name="group"      type="xs:string"/>
      <xs:attribute name="checked"    type="xs:boolean"/>
      <xs:attribute name="required"   type="xs:boolean"/>
      <xs:attribute name="readonly"   type="xs:boolean"/>
      <xs:attribute name="max-len"    type="xs:positiveInteger"/>
      <xs:attribute name="action-url" type="xs:anyURI"/>
      <xs:attributeGroup ref="WidthAttr"/>
      <xs:attribute name="height"     type="TokenScaleOrPt"/>
      <xs:attribute name="background" type="Color"/>
      <xs:attribute name="border"     type="BorderValue"/>
      <xs:attribute name="debug"      type="xs:boolean"/>
      <xs:attributeGroup ref="DataBindingAttrs"/>
    </xs:complexType>
  </xs:element>

</xs:schema>
