{
  "name": "lpdf",
  "version": "0.1.0",
  "description": "lpdf adapter — XML → PDF via Rust/WASM core (Node.js + browser)",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "require": "./dist/index.js",
      "types":   "./dist/index.d.ts"
    },
    "./browser": {
      "import": "./dist/browser.js",
      "types":  "./dist/browser.d.ts"
    }
  },
  "scripts": {
    "build":         "tsc && node build-browser.mjs",
    "build:node":    "tsc",
    "build:browser": "node build-browser.mjs",
    "test":          "node --test test/render.test.mjs"
  },
  "license": "AGPL-3.0-or-later OR LicenseRef-Commercial",
  "files": [
    "dist/"
  ],
  "devDependencies": {
    "@types/node": "^20.0.0",
    "esbuild":     "^0.25.0",
    "typescript":  "^5.0.0"
  }
}
