<lpdf version="1"
  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xsi:noNamespaceSchemaLocation="../../schema/lpdf.xsd">
  <tokens>
    <colors>
      <color name="primary"  value="#1763cf" />
      <color name="surface"  value="#ffffff" />
      <color name="bg"       value="#f5f7fa" />
      <color name="accent"   value="#e8f0fc" />
      <color name="muted"    value="#737373" />
      <color name="rule"     value="#dde3ed" />
    </colors>
  </tokens>
  <document size="a4" margin="40pt">
    <meta title="lpdf Showcase — Grid" subject="Layout primitives" />

      <!-- Grid -->
    <section background="surface">
      <layout>
      <column gap="xl">

        <column gap="xs">
          <text font-size="xxl" font="Helvetica-Bold" color="primary">Grid</text>
          <text font-size="m" color="muted">Multi-column layout — children placed into equal-width columns, rows stretch to tallest cell</text>
        </column>

        <!-- cols -->
        <column gap="m">
          <text font-size="l" font="Helvetica-Bold">cols</text>
          <column gap="xs">
            <text font-size="m" color="muted">cols="2"</text>
            <grid debug="true" cols="2" gap="s" background="bg" padding="s">
              <column background="accent" padding="s"><text font-size="m">Cell 1</text></column>
              <column background="accent" padding="s"><text font-size="m">Cell 2</text></column>
              <column background="accent" padding="s"><text font-size="m">Cell 3</text></column>
              <column background="accent" padding="s"><text font-size="m">Cell 4</text></column>
            </grid>
          </column>
          <column gap="xs">
            <text font-size="m" color="muted">cols="3"</text>
            <grid debug="true" cols="3" gap="s" background="bg" padding="s">
              <column background="accent" padding="s"><text font-size="m">Cell 1</text></column>
              <column background="accent" padding="s"><text font-size="m">Cell 2</text></column>
              <column background="accent" padding="s"><text font-size="m">Cell 3</text></column>
              <column background="accent" padding="s"><text font-size="m">Cell 4</text></column>
              <column background="accent" padding="s"><text font-size="m">Cell 5</text></column>
              <column background="accent" padding="s"><text font-size="m">Cell 6</text></column>
            </grid>
          </column>
          <column gap="xs">
            <text font-size="m" color="muted">cols="4"</text>
            <grid debug="true" cols="4" gap="s" background="bg" padding="s">
              <column background="accent" padding="s"><text font-size="m">Cell 1</text></column>
              <column background="accent" padding="s"><text font-size="m">Cell 2</text></column>
              <column background="accent" padding="s"><text font-size="m">Cell 3</text></column>
              <column background="accent" padding="s"><text font-size="m">Cell 4</text></column>
              <column background="accent" padding="s"><text font-size="m">Cell 5</text></column>
              <column background="accent" padding="s"><text font-size="m">Cell 6</text></column>
              <column background="accent" padding="s"><text font-size="m">Cell 7</text></column>
              <column background="accent" padding="s"><text font-size="m">Cell 8</text></column>
            </grid>
          </column>
          <column gap="xs">
            <text font-size="m" color="muted">cols="3" — rows stretch to tallest cell in the row</text>
            <grid debug="true" cols="3" gap="s" background="bg" padding="s">
              <column background="accent" padding="s"><text font-size="m">Short</text></column>
              <column background="accent" padding="s"><text font-size="m">Taller</text><text font-size="m">cell</text><text font-size="m">content</text></column>
              <column background="accent" padding="s"><text font-size="m">Short</text></column>
              <column background="accent" padding="s"><text font-size="m">Short</text></column>
              <column background="accent" padding="s"><text font-size="m">Short</text></column>
              <column background="accent" padding="s"><text font-size="m">Short</text></column>
            </grid>
          </column>
        </column>

        <!-- col-width (auto-fit) -->
        <column gap="m">
          <text font-size="l" font="Helvetica-Bold">col-width (auto-fit)</text>
          <column gap="xs">
            <text font-size="m" color="muted">col-width="100pt" — fit as many ≥100pt columns as possible</text>
            <grid debug="true" col-width="100pt" gap="s" background="bg" padding="s">
              <column background="accent" padding="s"><text font-size="m">Alpha</text></column>
              <column background="accent" padding="s"><text font-size="m">Beta</text></column>
              <column background="accent" padding="s"><text font-size="m">Gamma</text></column>
              <column background="accent" padding="s"><text font-size="m">Delta</text></column>
              <column background="accent" padding="s"><text font-size="m">Epsilon</text></column>
              <column background="accent" padding="s"><text font-size="m">Zeta</text></column>
            </grid>
          </column>
          <column gap="xs">
            <text font-size="m" color="muted">col-width="150pt" — fewer, wider columns</text>
            <grid debug="true" col-width="150pt" gap="s" background="bg" padding="s">
              <column background="accent" padding="s"><text font-size="m">Alpha</text></column>
              <column background="accent" padding="s"><text font-size="m">Beta</text></column>
              <column background="accent" padding="s"><text font-size="m">Gamma</text></column>
              <column background="accent" padding="s"><text font-size="m">Delta</text></column>
              <column background="accent" padding="s"><text font-size="m">Epsilon</text></column>
              <column background="accent" padding="s"><text font-size="m">Zeta</text></column>
            </grid>
          </column>
        </column>

        <!-- gap -->
        <column gap="m">
          <text font-size="l" font="Helvetica-Bold">gap</text>
          <column gap="xs">
            <text font-size="m" color="muted">gap="xs"</text>
            <grid debug="true" cols="3" gap="xs" background="bg" padding="s">
              <column background="accent" padding="s"><text font-size="m">Alpha</text></column>
              <column background="accent" padding="s"><text font-size="m">Beta</text></column>
              <column background="accent" padding="s"><text font-size="m">Gamma</text></column>
            </grid>
          </column>
          <column gap="xs">
            <text font-size="m" color="muted">gap="m"</text>
            <grid debug="true" cols="3" gap="m" background="bg" padding="s">
              <column background="accent" padding="s"><text font-size="m">Alpha</text></column>
              <column background="accent" padding="s"><text font-size="m">Beta</text></column>
              <column background="accent" padding="s"><text font-size="m">Gamma</text></column>
            </grid>
          </column>
          <column gap="xs">
            <text font-size="m" color="muted">gap="xl"</text>
            <grid debug="true" cols="3" gap="xl" background="bg" padding="s">
              <column background="accent" padding="s"><text font-size="m">Alpha</text></column>
              <column background="accent" padding="s"><text font-size="m">Beta</text></column>
              <column background="accent" padding="s"><text font-size="m">Gamma</text></column>
            </grid>
          </column>
        </column>

        <!-- padding -->
        <column gap="m">
          <text font-size="l" font="Helvetica-Bold">padding</text>
          <column gap="xs">
            <text font-size="m" color="muted">padding="xs"</text>
            <grid debug="true" cols="3" gap="s" padding="xs" background="bg">
              <column background="accent" padding="s"><text font-size="m">Alpha</text></column>
              <column background="accent" padding="s"><text font-size="m">Beta</text></column>
              <column background="accent" padding="s"><text font-size="m">Gamma</text></column>
            </grid>
          </column>
          <column gap="xs">
            <text font-size="m" color="muted">padding="l"</text>
            <grid debug="true" cols="3" gap="s" padding="l" background="bg">
              <column background="accent" padding="s"><text font-size="m">Alpha</text></column>
              <column background="accent" padding="s"><text font-size="m">Beta</text></column>
              <column background="accent" padding="s"><text font-size="m">Gamma</text></column>
            </grid>
          </column>
          <column gap="xs">
            <text font-size="m" color="muted">padding="20pt 8pt" (vertical · horizontal)</text>
            <grid debug="true" cols="3" gap="s" padding="20pt 8pt" background="bg">
              <column background="accent" padding="s"><text font-size="m">Alpha</text></column>
              <column background="accent" padding="s"><text font-size="m">Beta</text></column>
              <column background="accent" padding="s"><text font-size="m">Gamma</text></column>
            </grid>
          </column>
        </column>

        <!-- border · radius -->
        <column gap="m">
          <text font-size="l" font="Helvetica-Bold">border · radius</text>
          <column gap="xs">
            <text font-size="m" color="muted">border="xs rule" radius="xs"</text>
            <grid cols="3" gap="s" padding="s" border="xs rule" radius="xs">
              <column background="accent" padding="s"><text font-size="m">Alpha</text></column>
              <column background="accent" padding="s"><text font-size="m">Beta</text></column>
              <column background="accent" padding="s"><text font-size="m">Gamma</text></column>
            </grid>
          </column>
          <column gap="xs">
            <text font-size="m" color="muted">border="s primary" radius="l"</text>
            <grid cols="3" gap="s" padding="m" border="s primary" radius="l">
              <column background="accent" padding="s"><text font-size="m">Alpha</text></column>
              <column background="accent" padding="s"><text font-size="m">Beta</text></column>
              <column background="accent" padding="s"><text font-size="m">Gamma</text></column>
            </grid>
          </column>
          <column gap="xs">
            <text font-size="m" color="muted">background="accent" radius="m" padding="m"</text>
            <grid cols="3" gap="s" background="accent" radius="m" padding="m">
              <column background="surface" padding="s" radius="xs"><text font-size="m">Alpha</text></column>
              <column background="surface" padding="s" radius="xs"><text font-size="m">Beta</text></column>
              <column background="surface" padding="s" radius="xs"><text font-size="m">Gamma</text></column>
            </grid>
          </column>
        </column>

      </column>
      </layout>
    </section>

  </document>
</lpdf>
