<?xml version="1.0" encoding="UTF-8"?>
<lpdf version="1">
  <assets>
    <font name="body"    core="Helvetica"/>
    <font name="heading" core="Helvetica-Bold"/>
  </assets>
  <document size="a4" margin="48pt" font="body">
    <section>
      <layout>
        <column gap="m">

          <!-- header row: title + invoice number -->
          <row>
            <text font="heading" font-size="20pt">Invoice</text>
            <text width="fill" data-value="invoice_number" align="right">INV-2026-001</text>
          </row>

          <!-- customer details -->
          <column gap="xs">
            <text font="heading" data-value="customer.name">Acme Inc</text>
            <text data-value="customer.address">123 Main St</text>
          </column>

          <divider/>

          <!-- line items loop -->
          <column data-source="items" gap="xs">
            <row>
              <text data-value="description">Consulting Services</text>
              <text width="fill" data-value="price" align="right">$1,200.00</text>
            </row>
          </column>

          <divider/>

          <!-- total -->
          <row>
            <text font="heading">Total</text>
            <text width="fill" data-value="total" align="right" font="heading">$1,600.00</text>
          </row>

          <!-- premium badge (conditional) -->
          <frame data-if="customer.isPremium" background="#ffd700" padding="xs">
            <text align="center">★ Premium Customer</text>
          </frame>

          <!-- standard badge (conditional) -->
          <frame data-if-not="customer.isPremium" background="#f0f0f0" padding="xs">
            <text align="center">Standard Customer</text>
          </frame>

        </column>
      </layout>
    </section>
  </document>
</lpdf>
