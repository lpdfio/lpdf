  <document size="A4">
    <meta title="lpdf Showcase — Page sizes" subject="The named paper sizes a document and a section take" />

    <!-- The paper sizes `size` names beyond A3, A4, A5, Letter and Legal. Each section is one page with a border at
         its edge, and says what it is and what size it should have.
         Expected, eight pages in this order:
           1  size="A0"                              841 × 1189 mm
           2  size="A1"                              594 × 841 mm
           3  size="A2"                              420 × 594 mm
           4  size="A6"                              105 × 148 mm
           5  size="B4"                              250 × 353 mm
           6  size="B5"                              176 × 250 mm
           7  size="Tabloid"                         11 × 17 in, 279.4 × 431.8 mm
           8  size="Tabloid" orientation="landscape" 17 × 11 in, 431.8 × 279.4 mm, which is Ledger
    -->

    <section size="A0">
      <layout margin="0pt">
        <frame border="4pt primary" padding="xl" height="full">
          <column gap="s">
            <text font-size="xxl" font="Helvetica-Bold" color="primary">A0</text>
            <text font-size="m" color="muted">Expected: 841 × 1189 mm</text>
