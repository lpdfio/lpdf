<?xml version="1.0" encoding="UTF-8"?>
<lpdf version="1"
  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xsi:noNamespaceSchemaLocation="../../schema/lpdf.xsd">
  <tokens>
    <colors>
      <color name="primary" value="#1763cf" />
      <color name="muted"   value="#737373" />
    </colors>
  </tokens>
  <document size="A4" orientation="landscape">
    <meta title="lpdf Showcase — Section orientation" subject="An orientation names the shape of the page, on a section too" />

    <!-- `orientation` names the shape of the page you get: `portrait` is taller than wide and `landscape` is wider than
         tall, whatever size the page starts from. A section starts from the page of its document, here A4 on its side,
         or from its own `size`, which it takes as written when it has no `orientation`. Each section is one page with a
         border at its edge, and says what it is and what size it should have.
         Expected, eight pages in this order:
           1  no override                              A4 on its side, 297 × 210 mm
           2  orientation="portrait"                   A4 upright, 210 × 297 mm: the section turns the page back
           3  orientation="landscape"                  A4 on its side, 297 × 210 mm
           4  size="297mm 210mm" orientation="portrait"    upright, 210 × 297 mm
           5  size="297mm 210mm" orientation="landscape"   on its side, 297 × 210 mm
           6  size="A3"                                A3 upright, 297 × 420 mm: its own size as written
           7  size="A3" orientation="landscape"        A3 on its side, 420 × 297 mm
           8  size="200mm 200mm" orientation="portrait"    a square, 200 × 200 mm
    -->

    <section>
      <layout margin="0pt">
        <frame border="4pt primary" padding="xl" height="full">
          <column gap="s">
            <text font-size="xxl" font="Helvetica-Bold" color="primary">1 · No override</text>
            <text font-size="l">A section with no size and no orientation, in an A4 landscape document</text>
            <text font-size="m" color="muted">Expected: A4 on its side, 297 × 210 mm</text>
          </column>
        </frame>
      </layout>
    </section>

    <section orientation="portrait">
      <layout margin="0pt">
        <frame border="4pt primary" padding="xl" height="full">
          <column gap="s">
            <text font-size="xxl" font="Helvetica-Bold" color="primary">2 · Portrait</text>
            <text font-size="l">orientation="portrait" on a section of an A4 landscape document</text>
            <text font-size="m" color="muted">Expected: A4 upright, 210 × 297 mm</text>
          </column>
        </frame>
      </layout>
    </section>

    <section orientation="landscape">
      <layout margin="0pt">
        <frame border="4pt primary" padding="xl" height="full">
          <column gap="s">
            <text font-size="xxl" font="Helvetica-Bold" color="primary">3 · Landscape</text>
            <text font-size="l">orientation="landscape" on a section of an A4 landscape document</text>
            <text font-size="m" color="muted">Expected: A4 on its side, 297 × 210 mm</text>
          </column>
        </frame>
      </layout>
    </section>

    <section size="297mm 210mm" orientation="portrait">
      <layout margin="0pt">
        <frame border="4pt primary" padding="xl" height="full">
          <column gap="s">
            <text font-size="xxl" font="Helvetica-Bold" color="primary">4 · A size wider than tall, portrait</text>
            <text font-size="l">size="297mm 210mm" orientation="portrait"</text>
            <text font-size="m" color="muted">Expected: upright, 210 × 297 mm</text>
          </column>
        </frame>
      </layout>
    </section>

    <section size="297mm 210mm" orientation="landscape">
      <layout margin="0pt">
        <frame border="4pt primary" padding="xl" height="full">
          <column gap="s">
            <text font-size="xxl" font="Helvetica-Bold" color="primary">5 · A size wider than tall, landscape</text>
            <text font-size="l">size="297mm 210mm" orientation="landscape"</text>
            <text font-size="m" color="muted">Expected: on its side, 297 × 210 mm</text>
          </column>
        </frame>
      </layout>
    </section>

    <section size="A3">
      <layout margin="0pt">
        <frame border="4pt primary" padding="xl" height="full">
          <column gap="s">
            <text font-size="xxl" font="Helvetica-Bold" color="primary">6 · Its own size</text>
            <text font-size="l">size="A3" and no orientation, in an A4 landscape document</text>
            <text font-size="m" color="muted">Expected: A3 upright, 297 × 420 mm</text>
          </column>
        </frame>
      </layout>
    </section>

    <section size="A3" orientation="landscape">
      <layout margin="0pt">
        <frame border="4pt primary" padding="xl" height="full">
          <column gap="s">
            <text font-size="xxl" font="Helvetica-Bold" color="primary">7 · Its own size, landscape</text>
            <text font-size="l">size="A3" orientation="landscape"</text>
            <text font-size="m" color="muted">Expected: A3 on its side, 420 × 297 mm</text>
          </column>
        </frame>
      </layout>
    </section>

    <section size="200mm 200mm" orientation="portrait">
      <layout margin="0pt">
        <frame border="4pt primary" padding="xl" height="full">
          <column gap="s">
            <text font-size="xxl" font="Helvetica-Bold" color="primary">8 · A square</text>
            <text font-size="l">size="200mm 200mm" orientation="portrait"</text>
            <text font-size="m" color="muted">Expected: a square, 200 × 200 mm</text>
          </column>
        </frame>
      </layout>
    </section>
  </document>
</lpdf>
