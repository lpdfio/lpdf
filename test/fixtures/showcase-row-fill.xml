<lpdf version="1"
  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xsi:noNamespaceSchemaLocation="../../schema/lpdf.xsd">
  <tokens>
    <colors>
      <color name="primary"  value="#1763cf" />
      <color name="surface"  value="#ffffff" />
      <color name="bg"       value="#f5f7fa" />
      <color name="accent"   value="#e8f0fc" />
      <color name="muted"    value="#737373" />
      <color name="rule"     value="#dde3ed" />
    </colors>
  </tokens>
  <document size="a4" margin="40pt">
    <meta title="lpdf Showcase — Row: fill" subject="Layout primitives" />

      <!-- Row: fill -->
    <section background="surface">
      <layout>
      <column gap="xl">

        <column gap="xs">
          <text font-size="xxl" font="Helvetica-Bold" color="primary">Row: fill</text>
          <text font-size="m" color="muted">A child with width="fill" takes the width its line leaves; the others keep their own width</text>
        </column>

        <!-- which child fills -->
        <column gap="m">
          <text font-size="l" font="Helvetica-Bold">width="fill" (which child fills)</text>
          <column gap="xs">
            <text font-size="m" color="muted">fill on the last child — the other on the left</text>
            <row debug="true" gap="s" background="bg" padding="s">
              <column background="accent" padding="xs"><text font-size="m">Label</text></column>
              <column width="fill" background="rule" padding="xs"><text font-size="m">This content fills the remaining width</text></column>
            </row>
          </column>
          <column gap="xs">
            <text font-size="m" color="muted">fill on the first child — the other on the right</text>
            <row debug="true" gap="s" background="bg" padding="s">
              <column width="fill" background="rule" padding="xs"><text font-size="m">This content fills the remaining width</text></column>
              <column background="accent" padding="xs"><text font-size="m">Action</text></column>
            </row>
          </column>
          <column gap="xs">
            <text font-size="m" color="muted">fill on the last of three — two children on the left</text>
            <row debug="true" gap="s" background="bg" padding="s">
              <column background="accent" padding="xs"><text font-size="m">Icon</text></column>
              <column background="accent" padding="xs"><text font-size="m">Label</text></column>
              <column width="fill" background="rule" padding="xs"><text font-size="m">Fill content stretches to fit</text></column>
            </row>
          </column>
          <column gap="xs">
            <text font-size="m" color="muted">fill on the first of three — two children on the right</text>
            <row debug="true" gap="s" background="bg" padding="s">
              <column width="fill" background="rule" padding="xs"><text font-size="m">Fill content stretches to fit</text></column>
              <column background="accent" padding="xs"><text font-size="m">Edit</text></column>
              <column background="accent" padding="xs"><text font-size="m">Delete</text></column>
            </row>
          </column>
        </column>

        <!-- align (cross-axis = vertical) -->
        <column gap="m">
          <text font-size="l" font="Helvetica-Bold">align (cross-axis)</text>
          <column gap="xs">
            <text font-size="m" color="muted">align="start" — items top-aligned</text>
            <row debug="true" align="start" gap="s" background="bg" padding="s">
              <column background="accent" padding="xs"><text font-size="m">Short</text></column>
              <column width="fill" background="rule" padding="xs"><text font-size="m">Fill</text><text font-size="m">Two lines</text><text font-size="m">Three lines</text></column>
            </row>
          </column>
          <column gap="xs">
            <text font-size="m" color="muted">align="center" — items middle-aligned</text>
            <row debug="true" align="center" gap="s" background="bg" padding="s">
              <column background="accent" padding="xs"><text font-size="m">Short</text></column>
              <column width="fill" background="rule" padding="xs"><text font-size="m">Fill</text><text font-size="m">Two lines</text><text font-size="m">Three lines</text></column>
            </row>
          </column>
          <column gap="xs">
            <text font-size="m" color="muted">align="end" — items bottom-aligned</text>
            <row debug="true" align="end" gap="s" background="bg" padding="s">
              <column background="accent" padding="xs"><text font-size="m">Short</text></column>
              <column width="fill" background="rule" padding="xs"><text font-size="m">Fill</text><text font-size="m">Two lines</text><text font-size="m">Three lines</text></column>
            </row>
          </column>
        </column>

        <!-- gap -->
        <column gap="m">
          <text font-size="l" font="Helvetica-Bold">gap</text>
          <column gap="xs">
            <text font-size="m" color="muted">gap="xs"</text>
            <row debug="true" gap="xs" background="bg" padding="s">
              <column background="accent" padding="xs"><text font-size="m">Label</text></column>
              <column width="fill" background="rule" padding="xs"><text font-size="m">Fill</text></column>
            </row>
          </column>
          <column gap="xs">
            <text font-size="m" color="muted">gap="m"</text>
            <row debug="true" gap="m" background="bg" padding="s">
              <column background="accent" padding="xs"><text font-size="m">Label</text></column>
              <column width="fill" background="rule" padding="xs"><text font-size="m">Fill</text></column>
            </row>
          </column>
          <column gap="xs">
            <text font-size="m" color="muted">gap="xl"</text>
            <row debug="true" gap="xl" background="bg" padding="s">
              <column background="accent" padding="xs"><text font-size="m">Label</text></column>
              <column width="fill" background="rule" padding="xs"><text font-size="m">Fill</text></column>
            </row>
          </column>
        </column>

        <!-- padding -->
        <column gap="m">
          <text font-size="l" font="Helvetica-Bold">padding</text>
          <column gap="xs">
            <text font-size="m" color="muted">padding="xs"</text>
            <row debug="true" padding="xs" background="bg" gap="s">
              <column background="accent" padding="xs"><text font-size="m">Label</text></column>
              <column width="fill" background="rule" padding="xs"><text font-size="m">Fill</text></column>
            </row>
          </column>
          <column gap="xs">
            <text font-size="m" color="muted">padding="l"</text>
            <row debug="true" padding="l" background="bg" gap="s">
              <column background="accent" padding="xs"><text font-size="m">Label</text></column>
              <column width="fill" background="rule" padding="xs"><text font-size="m">Fill</text></column>
            </row>
          </column>
          <column gap="xs">
            <text font-size="m" color="muted">padding="20pt 8pt" (vertical · horizontal)</text>
            <row debug="true" padding="20pt 8pt" background="bg" gap="s">
              <column background="accent" padding="xs"><text font-size="m">Label</text></column>
              <column width="fill" background="rule" padding="xs"><text font-size="m">Fill</text></column>
            </row>
          </column>
        </column>

        <!-- border · radius -->
        <column gap="m">
          <text font-size="l" font="Helvetica-Bold">border · radius</text>
          <column gap="xs">
            <text font-size="m" color="muted">border="xs rule" radius="xs"</text>
            <row padding="s" gap="s" border="xs rule" radius="xs">
              <column background="accent" padding="xs"><text font-size="m">Label</text></column>
              <column width="fill" padding="xs"><text font-size="m">Fill content</text></column>
            </row>
          </column>
          <column gap="xs">
            <text font-size="m" color="muted">border="s primary" radius="l"</text>
            <row padding="m" gap="s" border="s primary" radius="l">
              <column background="accent" padding="xs"><text font-size="m">Label</text></column>
              <column width="fill" padding="xs"><text font-size="m">Fill content</text></column>
            </row>
          </column>
          <column gap="xs">
            <text font-size="m" color="muted">background="accent" radius="m" padding="m"</text>
            <row background="accent" radius="m" padding="m" gap="s">
              <column background="surface" padding="xs" radius="xs"><text font-size="m">Label</text></column>
              <column width="fill" background="surface" padding="xs" radius="xs"><text font-size="m">Fill content</text></column>
            </row>
          </column>
        </column>

      </column>
      </layout>
    </section>

  </document>
</lpdf>
