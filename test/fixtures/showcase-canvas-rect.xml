<?xml version="1.0" encoding="UTF-8"?>
<lpdf version="1"
  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xsi:noNamespaceSchemaLocation="../../schema/lpdf.xsd">
  <tokens>
    <colors>
      <color name="primary"  value="#1763cf"/>
      <color name="accent"   value="#e8f0fc"/>
      <color name="muted"    value="#737373"/>
      <color name="rule"     value="#dde3ed"/>
    </colors>
  </tokens>
  <document size="a4">
    <meta title="lpdf Showcase — Canvas Rect/Circle/Ellipse" subject="Canvas primitives"/>

    <!-- Layers only: rect, circle, ellipse primitives -->
    <section>
      <!-- Background layer: full-page colour block -->
      <layer page="each">
        <rect anchor="top-left" width="595.28pt" height="841.89pt" fill="#f5f7fa"/>
      </layer>

      <!-- Geometric shapes layer -->
      <layer>
        <!-- Rect: absolute coordinates -->
        <rect x="40pt" y="40pt" width="200pt" height="80pt" fill="primary" radius="6pt"/>

        <!-- Rect: anchor-based placement, bottom-right corner -->
        <rect anchor="bottom-right" x="-40pt" y="-40pt" width="160pt" height="60pt"
              fill="#ffffff" stroke="primary" stroke-width="2pt"/>

        <!-- Circle: absolute centre -->
        <circle x="330pt" y="70pt" r="50pt" fill="accent" stroke="primary" stroke-width="1.5pt"/>

      </layer>

      <!-- Circle: anchor-based centre, faded by a layer of its own -->
      <layer opacity="0.7">
        <circle anchor="center" r="40pt" fill="#ffffff" stroke="primary" stroke-width="2pt"/>
      </layer>

      <layer>
        <!-- Ellipse: absolute -->
        <ellipse x="50pt" y="250pt" rx="100pt" ry="50pt" fill="accent"/>
      </layer>

      <!-- Ellipse: anchor top-center, faded by a layer of its own -->
      <layer opacity="0.3">
        <ellipse anchor="top-center" y="170pt" rx="80pt" ry="30pt" fill="primary"/>
      </layer>

      <layer>
        <!-- Rounded rect: border only -->
        <rect x="40pt" y="400pt" width="515.28pt" height="1pt" fill="rule"/>

        <!-- Nested rects: card-like layout -->
        <rect x="40pt" y="420pt" width="240pt" height="140pt" radius="8pt"
              fill="#ffffff" stroke="rule" stroke-width="1pt"/>
        <rect x="50pt" y="430pt" width="80pt" height="80pt" radius="4pt" fill="accent"/>
        <rect x="50pt" y="520pt" width="220pt" height="1pt" fill="rule"/>

        <rect x="315.28pt" y="420pt" width="240pt" height="140pt" radius="8pt"
              fill="#ffffff" stroke="rule" stroke-width="1pt"/>
        <ellipse x="385.28pt" y="460pt" rx="50pt" ry="30pt" fill="accent"/>
      </layer>

      <!-- Opacity demo layer -->
      <layer opacity="0.5">
        <rect x="40pt" y="600pt" width="120pt" height="120pt" fill="primary"/>
        <rect x="80pt" y="640pt" width="120pt" height="120pt" fill="#e74c3c"/>
        <rect x="120pt" y="680pt" width="120pt" height="120pt" fill="#2ecc71"/>
      </layer>
    </section>
  </document>
</lpdf>
